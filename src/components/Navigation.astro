---
// Navigation — 13 section links, sticky, mobile responsive
---

<nav class="nav" id="main-nav" role="navigation" aria-label="Main navigation">
  <div class="nav-inner">
    <!-- Logo -->
    <a href="/" class="nav-logo" aria-label="MALAI VIZHI Home">
      <div class="nav-logo-mark" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
          <path d="M2 26L8 14L14 20L20 8L26 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M2 26H26" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.4"/>
          <!-- Contour lines -->
          <path d="M4 22Q8 19 12 20Q16 21 20 18" stroke="currentColor" stroke-width="0.75" fill="none" opacity="0.3"/>
          <path d="M6 18Q10 15 14 16Q18 17 22 14" stroke="currentColor" stroke-width="0.75" fill="none" opacity="0.2"/>
        </svg>
      </div>
      <div class="nav-logo-text">
        <span class="nav-logo-name">MALAI VIZHI</span>
        <span class="nav-logo-sub">LANDSLIDE RISK MONITORING</span>
      </div>
    </a>

    <!-- Desktop Nav Links -->
    <div class="nav-links" role="menubar" aria-label="Page sections">
      <a href="#home"             class="nav-link" role="menuitem">Home</a>
      <a href="#problem"          class="nav-link" role="menuitem">Problem</a>
      <a href="#how-it-works"     class="nav-link" role="menuitem">How It Works</a>
      <a href="#data"             class="nav-link" role="menuitem">Data</a>
      <a href="#risk-engine"      class="nav-link" role="menuitem">Risk Engine</a>
      <a href="#gis"              class="nav-link" role="menuitem">GIS</a>
      <a href="#citizen-reports"  class="nav-link" role="menuitem">Reports</a>
      <a href="#early-warning"    class="nav-link" role="menuitem">Warning</a>
      <a href="#simulation"       class="nav-link" role="menuitem">Simulation</a>
      <a href="#technology"       class="nav-link" role="menuitem">Tech</a>
      <a href="#team"             class="nav-link" role="menuitem">Team</a>
      <a href="#blog"             class="nav-link" role="menuitem">Blog</a>
    </div>

    <!-- Right actions -->
    <div class="nav-actions">
      <a href="https://backend-malaivizhi2-0.onrender.com/api/health"
         class="nav-status-pill" target="_blank" rel="noopener" aria-label="System status">
        <span class="nav-status-dot" id="nav-status-dot" aria-hidden="true"></span>
        <span class="nav-status-text" id="nav-status-text">Checking…</span>
      </a>
      <a href="#simulation" class="btn-primary" style="padding: 9px 18px; font-size: 0.8rem;">
        <span>Explore System</span>
        <svg class="btn-arrow" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <!-- Mobile hamburger -->
      <button class="nav-hamburger" id="nav-hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <span class="ham-bar"></span>
        <span class="ham-bar"></span>
        <span class="ham-bar"></span>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile Menu -->
<div class="mobile-menu" id="mobile-menu" aria-hidden="true" role="dialog" aria-label="Mobile navigation">
  <div class="mobile-menu-header">
    <div class="nav-logo-text">
      <span class="nav-logo-name" style="font-size: 1rem;">MALAI VIZHI</span>
    </div>
    <button class="mobile-menu-close" id="mobile-menu-close" aria-label="Close menu">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
        <path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
  <nav class="mobile-nav-links" aria-label="Mobile navigation">
    <a href="#home"            class="mobile-nav-link">Home</a>
    <a href="#problem"         class="mobile-nav-link">The Problem</a>
    <a href="#how-it-works"    class="mobile-nav-link">How It Works</a>
    <a href="#data"            class="mobile-nav-link">Data Sources</a>
    <a href="#risk-engine"     class="mobile-nav-link">Risk Engine</a>
    <a href="#gis"             class="mobile-nav-link">GIS & Monitoring</a>
    <a href="#citizen-reports" class="mobile-nav-link">Citizen Reports</a>
    <a href="#early-warning"   class="mobile-nav-link">Early Warning</a>
    <a href="#simulation"      class="mobile-nav-link">Simulation</a>
    <a href="#technology"      class="mobile-nav-link">Technology</a>
    <a href="#team"            class="mobile-nav-link">Team HIVE</a>
    <a href="#blog"            class="mobile-nav-link">Blog</a>
  </nav>
  <div class="mobile-menu-footer">
    <span class="badge badge-live"><span class="badge-dot"></span> SYSTEM ONLINE</span>
    <a href="https://backend-malaivizhi2-0.onrender.com/api/health" 
       class="btn-technical" target="_blank" rel="noopener">View API Status</a>
  </div>
</div>
<div class="mobile-overlay" id="mobile-overlay" aria-hidden="true"></div>

<style>
  /* ── Nav Shell ── */
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    height: var(--nav-h);
    background: rgba(250,250,250,0.92);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid var(--border);
    transition: height var(--ease-base), box-shadow var(--ease-base), background var(--ease-base);
  }

  .nav.scrolled {
    height: var(--nav-h-scroll);
    box-shadow: var(--shadow-sm);
    background: rgba(250,250,250,0.97);
  }

  .nav-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 var(--s8);
    height: 100%;
    display: flex;
    align-items: center;
    gap: var(--s6);
  }

  /* ── Logo ── */
  .nav-logo {
    display: flex;
    align-items: center;
    gap: var(--s3);
    flex-shrink: 0;
    color: var(--green-deep);
    transition: opacity var(--ease-fast);
  }

  .nav-logo:hover { opacity: 0.8; }

  .nav-logo-mark {
    width: 36px;
    height: 36px;
    background: var(--green-bg);
    border: 1px solid var(--border-green);
    border-radius: var(--r-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .nav-logo-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .nav-logo-name {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 800;
    letter-spacing: 0.04em;
    color: var(--text-navy);
    line-height: 1;
  }

  .nav-logo-sub {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    line-height: 1;
  }

  /* ── Desktop Links ── */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 0;
    flex: 1;
    justify-content: center;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .nav-links::-webkit-scrollbar { display: none; }

  .nav-link {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-secondary);
    padding: var(--s2) var(--s3);
    border-radius: var(--r-md);
    white-space: nowrap;
    transition: all var(--ease-fast);
    position: relative;
  }

  .nav-link:hover, .nav-link.active {
    color: var(--green-primary);
    background: var(--green-bg);
  }

  /* ── Right Actions ── */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--s3);
    flex-shrink: 0;
  }

  /* Status pill */
  .nav-status-pill {
    display: flex;
    align-items: center;
    gap: var(--s2);
    padding: 6px 10px;
    border-radius: var(--r-full);
    border: 1px solid var(--border);
    background: var(--bg-white);
    transition: all var(--ease-fast);
    cursor: pointer;
  }

  .nav-status-pill:hover { border-color: var(--border-mid); box-shadow: var(--shadow-sm); }

  .nav-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--status-unavail);
    flex-shrink: 0;
    transition: background var(--ease-base);
  }

  .nav-status-dot.live { background: var(--status-live); animation: livePulse 2s ease-in-out infinite; }
  .nav-status-dot.error { background: var(--risk-high); }

  .nav-status-text {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* ── Hamburger ── */
  .nav-hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: var(--s2);
    border-radius: var(--r-md);
    transition: background var(--ease-fast);
  }

  .nav-hamburger:hover { background: var(--bg-soft); }

  .ham-bar {
    display: block;
    width: 22px;
    height: 1.5px;
    background: var(--text-navy);
    border-radius: 2px;
    transition: all var(--ease-base);
  }

  .nav-hamburger[aria-expanded="true"] .ham-bar:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .nav-hamburger[aria-expanded="true"] .ham-bar:nth-child(2) { opacity: 0; }
  .nav-hamburger[aria-expanded="true"] .ham-bar:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  /* ── Mobile Menu ── */
  .mobile-menu {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(85vw, 360px);
    background: var(--bg-white);
    border-left: 1px solid var(--border);
    z-index: 1100;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform var(--ease-slow);
    box-shadow: var(--shadow-xl);
  }

  .mobile-menu.open { transform: translateX(0); }

  .mobile-overlay {
    position: fixed;
    inset: 0;
    background: rgba(15,30,60,0.4);
    backdrop-filter: blur(4px);
    z-index: 1050;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--ease-slow);
  }

  .mobile-overlay.open { opacity: 1; pointer-events: all; }

  .mobile-menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--s5) var(--s6);
    border-bottom: 1px solid var(--border);
  }

  .mobile-menu-close {
    width: 36px;
    height: 36px;
    border-radius: var(--r-md);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    transition: all var(--ease-fast);
  }

  .mobile-menu-close:hover { background: var(--bg-soft); color: var(--text-navy); }

  .mobile-nav-links {
    flex: 1;
    overflow-y: auto;
    padding: var(--s4) var(--s2);
    display: flex;
    flex-direction: column;
  }

  .mobile-nav-link {
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--text-secondary);
    padding: var(--s4) var(--s5);
    border-radius: var(--r-lg);
    transition: all var(--ease-fast);
    border-bottom: 1px solid var(--border);
  }

  .mobile-nav-link:last-child { border-bottom: none; }
  .mobile-nav-link:hover { background: var(--green-bg); color: var(--green-primary); }

  .mobile-menu-footer {
    padding: var(--s5) var(--s6);
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s4);
    background: var(--bg-soft);
    flex-wrap: wrap;
  }

  /* ── Responsive ── */
  @media (max-width: 1100px) {
    .nav-links { gap: 0; }
    .nav-link { padding: var(--s2) 9px; font-size: 0.7rem; }
  }

  @media (max-width: 900px) {
    .nav-links { display: none; }
    .nav-hamburger { display: flex; }
    .nav-status-pill { display: none; }
    .btn-primary { display: none; }
  }

  @media (max-width: 480px) {
    .nav-inner { padding: 0 var(--s5); }
    .nav-logo-sub { display: none; }
  }
</style>

<script>
  (() => {
    // Scroll behavior
    const nav = document.getElementById('main-nav');
    const scrollThreshold = 60;

    const updateNav = () => {
      if (window.scrollY > scrollThreshold) {
        nav?.classList.add('scrolled');
      } else {
        nav?.classList.remove('scrolled');
      }
    };

    window.addEventListener('scroll', updateNav, { passive: true });
    updateNav();

    // Active link tracking
    const navLinks = document.querySelectorAll('.nav-link, .mobile-nav-link');
    const sections = document.querySelectorAll('section[id]');

    const activateLink = (id: string) => {
      navLinks.forEach(link => {
        link.classList.toggle('active', link.getAttribute('href') === `#${id}`);
      });
    };

    const io = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) activateLink(entry.target.id);
      });
    }, { rootMargin: '-40% 0px -50% 0px' });

    sections.forEach(s => io.observe(s));

    // Mobile menu
    const hamburger = document.getElementById('nav-hamburger');
    const mobileMenu = document.getElementById('mobile-menu');
    const overlay = document.getElementById('mobile-overlay');
    const closeBtn = document.getElementById('mobile-menu-close');

    const openMenu = () => {
      mobileMenu?.classList.add('open');
      overlay?.classList.add('open');
      hamburger?.setAttribute('aria-expanded', 'true');
      mobileMenu?.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    };

    const closeMenu = () => {
      mobileMenu?.classList.remove('open');
      overlay?.classList.remove('open');
      hamburger?.setAttribute('aria-expanded', 'false');
      mobileMenu?.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    };

    hamburger?.addEventListener('click', openMenu);
    closeBtn?.addEventListener('click', closeMenu);
    overlay?.addEventListener('click', closeMenu);

    // Close on mobile link click
    document.querySelectorAll('.mobile-nav-link').forEach(link => {
      link.addEventListener('click', closeMenu);
    });

    // Keyboard close
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu();
    });

    // Smooth scroll for all anchor links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', (e) => {
        const href = anchor.getAttribute('href');
        if (!href || href === '#') return;
        const target = document.querySelector(href);
        if (target) {
          e.preventDefault();
          const offset = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--nav-h')) || 68;
          const top = target.getBoundingClientRect().top + window.scrollY - offset - 16;
          window.scrollTo({ top, behavior: 'smooth' });
        }
      });
    });

    // API health check
    const statusDot = document.getElementById('nav-status-dot');
    const statusText = document.getElementById('nav-status-text');

    fetch('https://backend-malaivizhi2-0.onrender.com/api/health', { signal: AbortSignal.timeout(6000) })
      .then(r => r.json())
      .then(data => {
        if (data.status === 'ok') {
          if (statusDot) { statusDot.className = 'nav-status-dot live'; }
          if (statusText) statusText.textContent = 'SYSTEM LIVE';
        }
      })
      .catch(() => {
        if (statusDot) { statusDot.className = 'nav-status-dot error'; }
        if (statusText) statusText.textContent = 'DEMO MODE';
      });

    // GSAP nav entrance
    if (typeof gsap !== 'undefined') {
      gsap.from('.nav-inner > *', {
        opacity: 0, y: -12, duration: 0.6, stagger: 0.08, ease: 'power2.out', delay: 0.2
      });
    }
  })();
</script>
