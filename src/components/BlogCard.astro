---
export interface Props {
  title: string;
  subtitle: string;
  href: string;
  category: string;
  readingTime: string;
  date: string;
  description: string;
  featured?: boolean;
}

const { title, subtitle, href, category, readingTime, date, description, featured = false } = Astro.props;
---

<article class={`blog-card ${featured ? 'blog-card--featured' : ''}`} aria-labelledby={`blog-card-title-${href.replace(/\//g, '-')}`}>
  <a href={href} class="blog-card-link" tabindex="-1" aria-hidden="true">
    <div class="blog-card-visual">
      <div class="blog-card-bg"></div>
      <span class="blog-card-category-overlay">{category}</span>
    </div>
  </a>
  <div class="blog-card-body">
    <div class="blog-card-meta">
      <span class="blog-card-category">{category}</span>
      <span class="blog-card-sep" aria-hidden="true">·</span>
      <span class="blog-card-reading">{readingTime}</span>
      <span class="blog-card-sep" aria-hidden="true">·</span>
      <time class="blog-card-date">{date}</time>
    </div>
    <h2 class="blog-card-title" id={`blog-card-title-${href.replace(/\//g, '-')}`}>
      <a href={href} class="blog-card-title-link">{title}</a>
    </h2>
    <p class="blog-card-subtitle">{subtitle}</p>
    <p class="blog-card-desc">{description}</p>
    <a href={href} class="blog-card-cta btn btn-ghost">
      Read Article
      <svg class="btn-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</article>

<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    transition: all var(--transition-base);
  }

  .blog-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
    border-color: var(--color-border-strong);
  }

  .blog-card--featured {
    grid-column: 1 / -1;
    flex-direction: row;
  }

  .blog-card-link {
    display: block;
    text-decoration: none;
  }

  .blog-card-visual {
    position: relative;
    background: linear-gradient(135deg, #D8F3DC 0%, #B7E4C7 50%, #95D5B2 100%);
    aspect-ratio: 16 / 9;
    overflow: hidden;
    min-height: 200px;
  }

  .blog-card--featured .blog-card-visual {
    flex: 1;
    aspect-ratio: unset;
    min-height: 320px;
  }

  .blog-card-bg {
    position: absolute;
    inset: 0;
    background: url("data:image/svg+xml,%3Csvg viewBox='0 0 400 250' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 250L60 160 120 200 200 100 280 160 340 120 400 150 400 250Z' fill='%2340916C' opacity='0.3'/%3E%3Cpath d='M0 250L80 200 160 220 240 160 320 180 400 140 400 250Z' fill='%232D6A4F' opacity='0.2'/%3E%3C/svg%3E") center/cover no-repeat;
  }

  .blog-card-category-overlay {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-green-deep);
    background: rgba(255,255,255,0.85);
    backdrop-filter: blur(8px);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
  }

  .blog-card-body {
    padding: var(--space-6) var(--space-7);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .blog-card--featured .blog-card-body {
    flex: 1;
    justify-content: center;
    padding: var(--space-10) var(--space-10);
  }

  .blog-card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
  }

  .blog-card-category {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-green-primary);
  }

  .blog-card-sep {
    color: var(--color-text-light);
    font-size: var(--text-xs);
  }

  .blog-card-reading, .blog-card-date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .blog-card-title {
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin-bottom: var(--space-2);
  }

  .blog-card--featured .blog-card-title {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
  }

  .blog-card-title-link {
    color: var(--color-text-primary);
    transition: color var(--transition-fast);
  }

  .blog-card-title-link:hover {
    color: var(--color-green-primary);
  }

  .blog-card-subtitle {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-green-primary);
    margin-bottom: var(--space-3);
    letter-spacing: 0.01em;
  }

  .blog-card-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: var(--space-6);
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card-cta {
    align-self: flex-start;
    font-size: var(--text-sm);
    color: var(--color-green-primary);
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0;
    transition: all var(--transition-fast);
  }

  .blog-card-cta .btn-arrow {
    transition: transform var(--transition-base);
  }

  .blog-card-cta:hover .btn-arrow {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .blog-card--featured {
      flex-direction: column;
    }
    .blog-card--featured .blog-card-body {
      padding: var(--space-6) var(--space-6);
    }
  }
</style>
