---
// Citizen Reports Feed — fetches from /api/reports
---

<div class="reports-feed" id="reports-feed">
  <div class="reports-feed-header">
    <div class="reports-header-left">
      <span class="badge badge-live" id="reports-badge">
        <span class="badge-dot"></span>LOADING REPORTS…
      </span>
      <span class="section-label-text">CITIZEN GROUND REPORTS</span>
    </div>
    <span class="illustrative-note" style="font-size: 0.6rem; padding: 2px 6px;">REAL API DATA</span>
  </div>
  <div class="reports-list" id="reports-list">
    {Array.from({length: 2}).map(() => (
      <div class="alert-skeleton" style="height: 80px; margin: var(--s3) var(--s6);"></div>
    ))}
  </div>
  <div class="reports-disclaimer">
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
      <path d="M7 1L13 12H1L7 1Z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/>
      <path d="M7 5.5v3M7 9.5v.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
    </svg>
    <span>
      Citizen reports provide additional ground-level context and do <strong>not</strong> directly modify the official environmental risk score. Reports are subject to verification.
    </span>
  </div>
</div>

<style>
  .reports-feed {
    background: var(--bg-white);
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .reports-feed-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--s4) var(--s6);
    border-bottom: 1px solid var(--border);
    background: var(--bg-soft);
    gap: var(--s4);
    flex-wrap: wrap;
  }

  .reports-header-left {
    display: flex;
    align-items: center;
    gap: var(--s4);
  }

  .reports-list { display: flex; flex-direction: column; }

  .report-item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--s4);
    align-items: flex-start;
    padding: var(--s5) var(--s6);
    border-bottom: 1px solid var(--border);
    transition: background var(--ease-fast);
    animation: fadeIn 0.4s ease forwards;
  }

  .report-item:last-child { border-bottom: none; }
  .report-item:hover { background: var(--bg-soft); }

  .report-category-icon {
    width: 36px;
    height: 36px;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    flex-shrink: 0;
  }

  .report-body { min-width: 0; }

  .report-header {
    display: flex;
    align-items: center;
    gap: var(--s3);
    margin-bottom: 4px;
    flex-wrap: wrap;
  }

  .report-category {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-navy);
  }

  .report-location {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .report-desc {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 4px;
  }

  .report-meta {
    display: flex;
    gap: var(--s3);
    flex-wrap: wrap;
    align-items: center;
  }

  .report-time {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--text-light);
    letter-spacing: 0.06em;
  }

  .status-VERIFIED  { color: var(--risk-low); background: var(--risk-low-bg); border-color: var(--risk-low-border); }
  .status-RESOLVED  { color: var(--status-demo); background: #EFF6FF; border-color: #BFDBFE; }
  .status-PENDING   { color: var(--status-limited); background: var(--risk-mod-bg); border-color: var(--risk-mod-border); }

  .reports-disclaimer {
    display: flex;
    align-items: flex-start;
    gap: var(--s3);
    padding: var(--s4) var(--s6);
    background: var(--bg-soft);
    border-top: 1px solid var(--border);
    font-size: var(--text-xs);
    color: var(--text-muted);
    line-height: 1.6;
  }

  .reports-disclaimer svg { flex-shrink: 0; margin-top: 1px; }
  .reports-disclaimer strong { color: var(--text-navy); }

  .alert-skeleton {
    background: linear-gradient(90deg, var(--bg-soft) 25%, var(--bg-muted) 50%, var(--bg-soft) 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
    border-radius: var(--r-md);
  }

  @keyframes shimmer {
    0%   { background-position: -200% 0; }
    100% { background-position:  200% 0; }
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  (() => {
    const list = document.getElementById('reports-list');
    const badge = document.getElementById('reports-badge');

    const catIcon = (cat) => {
      const icons = {
        'Mudslide & Debris': '🪨', 'Tension Cracks': '〰', 'Landslide': '⛰',
        'Flood': '🌊', 'Road Damage': '🚧', 'Rockfall': '🪨',
        'Drainage Blockage': '💧', 'Water Logging': '💧', 'Other': '📋',
      };
      return icons[cat] || '📍';
    };

    const formatTime = (ts) => {
      try {
        const d = new Date(ts.replace(' ', 'T') + '+00:00');
        return d.toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', dateStyle: 'short', timeStyle: 'short' }) + ' IST';
      } catch { return ts; }
    };

    fetch('https://backend-malaivizhi2-0.onrender.com/api/reports', { signal: AbortSignal.timeout(10000) })
      .then(r => r.json())
      .then(data => {
        if (!list) return;
        list.innerHTML = '';

        if (badge) badge.innerHTML = `<span class="badge-dot"></span>${data.length} GROUND REPORT${data.length !== 1 ? 'S' : ''}`;

        if (!Array.isArray(data) || data.length === 0) {
          list.innerHTML = '<div style="padding: var(--s6); text-align:center; font-size: var(--text-sm); color: var(--text-muted);">No citizen reports on record.</div>';
          return;
        }

        data.forEach((report, i) => {
          const item = document.createElement('div');
          item.className = 'report-item';
          item.style.animationDelay = `${i * 0.1}s`;
          item.innerHTML = `
            <div class="report-category-icon">${catIcon(report.category)}</div>
            <div class="report-body">
              <div class="report-header">
                <span class="report-category">${report.category}</span>
                <span class="report-location">${report.location}</span>
              </div>
              <p class="report-desc">${report.description}</p>
              <div class="report-meta">
                <span class="report-time">Submitted: ${formatTime(report.submitted_at)}</span>
                ${report.verified_at ? `<span class="report-time">Verified: ${formatTime(report.verified_at)}</span>` : ''}
              </div>
            </div>
            <div>
              <span class="badge status-${report.status}">${report.status}</span>
            </div>
          `;
          list.appendChild(item);
        });
      })
      .catch(() => {
        if (list) list.innerHTML = '<div style="padding: var(--s6); text-align:center; font-size: var(--text-sm); color: var(--text-muted);">Unable to load reports — backend may be starting up.</div>';
        if (badge) { badge.innerHTML = '<span class="badge-dot"></span>DEMO MODE'; badge.className = 'badge badge-limited'; }
      });
  })();
</script>
