---
const stages = [
  {
    id: "collect",
    number: "01",
    label: "COLLECT",
    title: "Data Collection",
    color: "#2D6A4F",
    items: ["Rainfall", "Soil Moisture", "Terrain & Slope", "Historical Hazard Info", "GIS / Location Data", "Ground Sensor Data", "Citizen Reports"],
    icon: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none"><path d="M14 4v8M10 8l4 4 4-4M6 18h16M8 22h12" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
    desc: "Environmental and terrain data gathered from multiple sources.",
  },
  {
    id: "process",
    number: "02",
    label: "PROCESS",
    title: "Data Processing",
    color: "#40916C",
    items: ["Data Validation", "Normalization", "Availability Check", "Multi-Source Processing"],
    icon: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none"><rect x="4" y="4" width="20" height="20" rx="4" stroke="currentColor" stroke-width="1.75"/><path d="M9 14h10M14 9v10" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>`,
    desc: "Raw data is validated, normalized, and checked for availability.",
  },
  {
    id: "assess",
    number: "03",
    label: "ASSESS",
    title: "Risk Assessment",
    color: "#1B4332",
    items: ["Multi-Factor Analysis", "Risk Score 0–100", "Risk Level Classification", "Explainable Factors"],
    icon: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none"><path d="M4 22L10 12l5 7 4-5 5 8H4Z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/></svg>`,
    desc: "Multi-factor landslide risk analysis generates a risk score and level.",
  },
  {
    id: "warn",
    number: "04",
    label: "WARN",
    title: "Early Warning",
    color: "#D97706",
    items: ["Location-Based Alerts", "Authority Notification", "Status Dashboard", "Risk Level Change"],
    icon: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none"><path d="M14 4L4 22h20L14 4Z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/><path d="M14 13v5M14 20v.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>`,
    desc: "When risk conditions change, location-based early warnings are communicated.",
  },
  {
    id: "respond",
    number: "05",
    label: "RESPOND",
    title: "Response",
    color: "#DC2626",
    items: ["Citizen Action", "Authority Action", "Monitoring", "Community Safety"],
    icon: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none"><path d="M14 4a10 10 0 1 1 0 20A10 10 0 0 1 14 4Z" stroke="currentColor" stroke-width="1.75"/><path d="M10 14l3 3 5-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
    desc: "Communities and authorities take informed action based on the risk assessment.",
  },
];
---

<div class="pipeline-wrapper" id="pipeline-section">
  <div class="pipeline-container">
    {stages.map((stage, i) => (
      <div class="pipeline-stage reveal" id={`stage-${stage.id}`} style={`--stage-color: ${stage.color}`}>
        <!-- Connector line (not last) -->
        {i < stages.length - 1 && (
          <div class="pipeline-connector" aria-hidden="true">
            <svg class="connector-svg" viewBox="0 0 2 60" fill="none" xmlns="http://www.w3.org/2000/svg">
              <line class="connector-line" x1="1" y1="0" x2="1" y2="60" stroke="#CBD5E1" stroke-width="1.5" stroke-dasharray="4 3"/>
            </svg>
            <span class="connector-arrow" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M8 3v10M4 9l4 4 4-4" stroke="#CBD5E1" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </div>
        )}

        <!-- Stage card -->
        <div class="stage-card" tabindex="0" role="article" aria-labelledby={`stage-title-${stage.id}`}>
          <div class="stage-header">
            <div class="stage-num-wrap">
              <span class="stage-number">{stage.number}</span>
            </div>
            <div class="stage-icon" aria-hidden="true" set:html={stage.icon} />
            <div>
              <span class="stage-label">{stage.label}</span>
              <h3 class="stage-title" id={`stage-title-${stage.id}`}>{stage.title}</h3>
            </div>
          </div>
          <p class="stage-desc">{stage.desc}</p>
          <ul class="stage-items" role="list">
            {stage.items.map(item => (
              <li class="stage-item">
                <span class="stage-dot" aria-hidden="true"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .pipeline-wrapper {
    display: flex;
    justify-content: center;
  }

  .pipeline-container {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    max-width: 640px;
    width: 100%;
    gap: 0;
  }

  .pipeline-stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .stage-card {
    width: 100%;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--stage-color, var(--color-green-primary));
    border-radius: var(--radius-xl);
    padding: var(--space-6) var(--space-8);
    transition: all var(--transition-base);
    cursor: default;
  }

  .stage-card:hover, .stage-card:focus {
    box-shadow: var(--shadow-lg);
    transform: translateX(4px);
    outline: none;
    border-left-width: 5px;
  }

  .stage-header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
  }

  .stage-num-wrap {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    background: var(--stage-color, var(--color-green-primary));
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .stage-number {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.05em;
  }

  .stage-icon {
    color: var(--stage-color, var(--color-green-primary));
    flex-shrink: 0;
  }

  .stage-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--stage-color, var(--color-green-primary));
    display: block;
    margin-bottom: 2px;
  }

  .stage-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }

  .stage-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.65;
    margin-bottom: var(--space-4);
  }

  .stage-items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .stage-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .stage-dot {
    width: 5px;
    height: 5px;
    border-radius: var(--radius-full);
    background: var(--stage-color, var(--color-green-primary));
    flex-shrink: 0;
  }

  /* Connector */
  .pipeline-connector {
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 52px;
    flex-shrink: 0;
  }

  .connector-svg {
    width: 2px;
    height: 36px;
    flex-shrink: 0;
  }

  .connector-arrow {
    display: flex;
    color: var(--color-slate-light);
    margin-top: -2px;
  }

  @media (max-width: 640px) {
    .stage-card {
      padding: var(--space-5) var(--space-5);
    }
    .stage-items {
      gap: var(--space-1);
    }
  }
</style>

<script>
  (() => {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;
    gsap.registerPlugin(ScrollTrigger);

    const stages = document.querySelectorAll('#pipeline-section .pipeline-stage');
    stages.forEach((stage, i) => {
      gsap.from(stage.querySelector('.stage-card'), {
        opacity: 0,
        x: -30,
        duration: 0.7,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: stage,
          start: 'top 80%',
          once: true,
        },
        delay: i * 0.1,
      });
    });
  })();
</script>
