---
export interface Props {
  value?: number; // 0–100
  label?: string;
}
const { value = 68, label = "Risk Score" } = Astro.props;
---

<div class="risk-meter-wrapper" id="risk-meter-section">
  <div class="risk-meter-container reveal">

    <!-- Arc Gauge -->
    <div class="risk-arc-wrapper" role="img" aria-label={`Risk meter showing ${value} out of 100`}>
      <svg class="risk-arc-svg" viewBox="0 0 280 200" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Zone arcs (background) -->
        <!-- LOW zone: 0-33 of 220deg arc -->
        <path class="arc-zone-bg arc-low"
          d="M 28 168 A 112 112 0 0 1 92 56"
          stroke="#DCFCE7" stroke-width="18" stroke-linecap="round" fill="none"/>
        <!-- MODERATE zone: 33-67 -->
        <path class="arc-zone-bg arc-mod"
          d="M 92 56 A 112 112 0 0 1 188 56"
          stroke="#FEF3C7" stroke-width="18" stroke-linecap="round" fill="none"/>
        <!-- HIGH zone: 67-100 -->
        <path class="arc-zone-bg arc-high"
          d="M 188 56 A 112 112 0 0 1 252 168"
          stroke="#FEE2E2" stroke-width="18" stroke-linecap="round" fill="none"/>

        <!-- Progress arc (animated) -->
        <path id="risk-progress-arc" class="arc-progress"
          d="M 28 168 A 112 112 0 0 1 252 168"
          stroke="#2D6A4F" stroke-width="18" stroke-linecap="round" fill="none"
          stroke-dasharray="365"
          stroke-dashoffset="365"/>

        <!-- Needle -->
        <g id="risk-needle" class="risk-needle" transform="rotate(-110, 140, 168)">
          <line x1="140" y1="168" x2="140" y2="72" stroke="#111827" stroke-width="2.5" stroke-linecap="round"/>
          <circle cx="140" cy="168" r="7" fill="#111827"/>
          <circle cx="140" cy="168" r="3.5" fill="white"/>
        </g>

        <!-- Score text -->
        <text id="risk-score-text" x="140" y="148" text-anchor="middle"
          font-family="Inter, sans-serif" font-weight="900" font-size="44"
          fill="#111827">0</text>
        <text x="140" y="168" text-anchor="middle"
          font-family="JetBrains Mono, monospace" font-size="10" fill="#6B7280" letter-spacing="3">/ 100</text>
      </svg>

      <!-- Zone labels below arc -->
      <div class="arc-zone-labels">
        <span class="arc-label arc-label-low">LOW</span>
        <span class="arc-label arc-label-mod">MODERATE</span>
        <span class="arc-label arc-label-high">HIGH</span>
      </div>
    </div>

    <!-- Risk Level Badge -->
    <div class="risk-level-display">
      <span id="risk-level-badge" class="risk-badge risk-mod-bg">MODERATE</span>
    </div>

    <!-- Score explanation -->
    <div class="risk-meter-info">
      <p class="risk-meter-desc">
        The risk score represents the level of landslide hazard indicated by the available environmental and terrain inputs.
      </p>
    </div>

    <!-- Risk vs Confidence -->
    <div class="risk-confidence-grid">
      <div class="risk-conf-card">
        <div class="risk-conf-icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path d="M12 2L4 8v8l8 6 8-6V8L12 2Z" stroke="#2D6A4F" stroke-width="1.75" stroke-linejoin="round"/>
            <path d="M12 8v4M12 16h.01" stroke="#2D6A4F" stroke-width="1.75" stroke-linecap="round"/>
          </svg>
        </div>
        <p class="risk-conf-label">Risk</p>
        <p class="risk-conf-question">What level of hazard is indicated?</p>
        <div class="risk-conf-bar">
          <div class="risk-conf-fill" style="width:68%; background: var(--color-risk-moderate);"></div>
        </div>
      </div>
      <div class="risk-conf-card">
        <div class="risk-conf-icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="9" stroke="#40916C" stroke-width="1.75"/>
            <path d="M9 12l2 2 4-4" stroke="#40916C" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <p class="risk-conf-label">Confidence</p>
        <p class="risk-conf-question">How complete and fresh is the available data?</p>
        <div class="risk-conf-bar">
          <div class="risk-conf-fill" style="width:52%; background: var(--color-green-primary);"></div>
        </div>
      </div>
    </div>

    <p class="illustrative-note">— Illustrative Example —</p>
  </div>
</div>

<style>
  .risk-meter-wrapper {
    display: flex;
    justify-content: center;
    padding: var(--space-8) 0;
  }

  .risk-meter-container {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: var(--space-10) var(--space-12);
    max-width: 600px;
    width: 100%;
    box-shadow: var(--shadow-lg);
    text-align: center;
  }

  .risk-arc-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .risk-arc-svg {
    width: 280px;
    max-width: 100%;
    overflow: visible;
  }

  .arc-progress {
    transition: stroke var(--transition-slow);
  }

  .risk-needle {
    transform-origin: 140px 168px;
  }

  .arc-zone-labels {
    display: flex;
    justify-content: space-between;
    width: 100%;
    padding: 0 var(--space-2);
    margin-top: var(--space-2);
  }

  .arc-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .arc-label-low  { color: var(--color-risk-low); }
  .arc-label-mod  { color: var(--color-risk-moderate); }
  .arc-label-high { color: var(--color-risk-high); }

  .risk-level-display {
    margin: var(--space-4) 0;
  }

  .risk-meter-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: var(--space-6);
    max-width: 420px;
    margin-left: auto;
    margin-right: auto;
  }

  .risk-confidence-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-top: var(--space-6);
    text-align: left;
  }

  .risk-conf-card {
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5) var(--space-5);
  }

  .risk-conf-icon {
    margin-bottom: var(--space-3);
  }

  .risk-conf-label {
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--color-text-primary);
    margin-bottom: var(--space-2);
  }

  .risk-conf-question {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }

  .risk-conf-bar {
    width: 100%;
    height: 5px;
    background: var(--color-slate-light);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .risk-conf-fill {
    height: 100%;
    border-radius: var(--radius-full);
    width: 0;
    transition: width 1.5s cubic-bezier(0.4,0,0.2,1);
  }

  .illustrative-note {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-light);
    letter-spacing: 0.1em;
    margin-top: var(--space-6);
    text-align: center;
  }

  @media (max-width: 640px) {
    .risk-meter-container { padding: var(--space-8) var(--space-6); }
    .risk-confidence-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  (() => {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;
    gsap.registerPlugin(ScrollTrigger);

    const targetScore = 68;
    // Map 0-100 to stroke-dashoffset (365 = full arc hidden, 0 = fully visible)
    function scoreToOffset(score: number) {
      const radius = 90;
      const circumference = Math.PI * radius; // semi-circle
      const pct = score / 100;
      return circumference * (1 - pct);
    }

    function scoreToRotation(score: number) {
      // 0 to 100 -> -90deg to 90deg
      return -90 + (score / 100) * 180;
    }

    function getArcColor(score: number) {
      if (score >= 75) return 'var(--risk-high)';
      if (score >= 45) return 'var(--risk-mod)';
      return 'var(--risk-low)';
    }

    function getLevelText(score: number) {
      if (score >= 75) return { text: 'HIGH', cls: 'risk-high-bg' };
      if (score >= 45) return { text: 'MODERATE', cls: 'risk-mod-bg' };
      return { text: 'LOW', cls: 'risk-low-bg' };
    }

    function updateMeter(score: number) {
      const v = Math.round(score);
      if (scoreText) scoreText.textContent = String(v);
      if (progressArc) {
        progressArc.style.strokeDashoffset = String(scoreToOffset(v));
        progressArc.style.stroke = getArcColor(v);
      }
      if (needle) {
        needle.setAttribute('transform', `rotate(${scoreToRotation(v)}, 140, 168)`);
      }
    }

    const progressArc = document.getElementById('risk-progress-arc');
    const scoreText = document.getElementById('risk-score-text');
    const needle = document.getElementById('risk-needle');
    const levelBadge = document.getElementById('risk-level-badge');
    const confFills = document.querySelectorAll('.risk-conf-fill');

    ScrollTrigger.create({
      trigger: '#risk-meter-section',
      start: 'top 70%',
      once: true,
      onEnter: () => {
        // Animate score counter
        let obj = { val: 0 };
        gsap.to(obj, {
          val: targetScore,
          duration: 2,
          ease: 'power2.out',
          onUpdate: () => {
            const v = Math.round(obj.val);
            if (scoreText) scoreText.textContent = String(v);
            if (progressArc) {
              progressArc.style.strokeDashoffset = String(scoreToOffset(v));
              progressArc.style.stroke = getArcColor(v);
            }
            if (needle) {
              needle.setAttribute('transform', `rotate(${scoreToRotation(v)}, 140, 168)`);
            }
          },
          onComplete: () => {
            const { text, cls } = getLevelText(targetScore);
            if (levelBadge) {
              levelBadge.textContent = text;
              levelBadge.className = `risk-badge ${cls}`;
            }
          }
        });

        // Animate confidence bars
        confFills.forEach(fill => {
          const w = (fill as HTMLElement).style.width;
          (fill as HTMLElement).style.width = '0';
          setTimeout(() => {
            (fill as HTMLElement).style.width = w;
          }, 400);
        });
      }
    });
  })();
</script>
