---
export interface Props {
  name?: string;
  role?: string;
  index?: number;
}

const { name = "Team Member", role = "Role", index = 1 } = Astro.props;
const initials = name.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();
---

<div class="team-card reveal" style={`--delay: ${index * 0.1}s`}>
  <div class="team-avatar" aria-hidden="true">
    <span class="team-initials">{initials}</span>
    <div class="team-avatar-bg"></div>
  </div>
  <div class="team-info">
    <h3 class="team-name">{name}</h3>
    <p class="team-role">{role}</p>
  </div>
  <div class="team-accent" aria-hidden="true"></div>
</div>

<style>
  .team-card {
    position: relative;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8) var(--space-6);
    text-align: center;
    transition: all var(--transition-base);
    overflow: hidden;
  }

  .team-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-6px);
    border-color: rgba(45,106,79,0.3);
  }

  .team-card:hover .team-accent {
    opacity: 1;
    transform: scale(1.2);
  }

  .team-accent {
    position: absolute;
    top: -40px;
    right: -40px;
    width: 120px;
    height: 120px;
    background: radial-gradient(circle, rgba(45,106,79,0.08) 0%, transparent 70%);
    border-radius: var(--radius-full);
    opacity: 0;
    transform: scale(0.8);
    transition: all var(--transition-slow);
    pointer-events: none;
  }

  .team-avatar {
    position: relative;
    width: 80px;
    height: 80px;
    margin: 0 auto var(--space-5);
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, var(--color-green-pale), var(--color-green-light));
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .team-avatar-bg {
    position: absolute;
    inset: 0;
    background: url("data:image/svg+xml,%3Csvg viewBox='0 0 80 80' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 80L20 40 40 60 60 30 80 50 80 80Z' fill='%232D6A4F' opacity='0.2'/%3E%3C/svg%3E") center/cover;
  }

  .team-initials {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: var(--text-xl);
    color: var(--color-green-deep);
    position: relative;
    z-index: 1;
    letter-spacing: 0.05em;
  }

  .team-info {
    position: relative;
    z-index: 1;
  }

  .team-name {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: var(--space-1);
    letter-spacing: -0.01em;
  }

  .team-role {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-green-primary);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
  }
</style>
