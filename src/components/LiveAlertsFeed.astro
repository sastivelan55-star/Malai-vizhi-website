---
// Live Alerts Feed — fetches from /api/alerts
---

<div class="alerts-feed" id="alerts-feed">
  <div class="alerts-feed-header">
    <div class="alerts-feed-title">
      <span class="badge badge-live" id="alerts-live-badge">
        <span class="badge-dot"></span>FETCHING ALERTS…
      </span>
      <span class="section-label-text">ACTIVE ALERTS — NORTH EASTERN REGION</span>
    </div>
    <p class="alerts-feed-timestamp" id="alerts-timestamp"></p>
  </div>
  <div class="alerts-list" id="alerts-list">
    <!-- Skeleton loaders -->
    {Array.from({length: 3}).map(() => (
      <div class="alert-skeleton"></div>
    ))}
  </div>
  <div class="alerts-disclaimer">
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
      <circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.25"/>
      <path d="M7 4.5v3.5M7 9.5v.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
    </svg>
    <span>Alerts are based on available environmental data and do not guarantee landslide occurrence. Data confidence may be LIMITED.</span>
  </div>
</div>

<style>
  .alerts-feed {
    background: var(--bg-white);
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .alerts-feed-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--s4) var(--s6);
    border-bottom: 1px solid var(--border);
    background: var(--bg-soft);
    gap: var(--s4);
    flex-wrap: wrap;
  }

  .alerts-feed-title {
    display: flex;
    align-items: center;
    gap: var(--s4);
  }

  .alerts-feed-timestamp {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--text-muted);
    letter-spacing: 0.06em;
  }

  .alerts-list {
    display: flex;
    flex-direction: column;
  }

  .alert-item {
    display: flex;
    align-items: flex-start;
    gap: var(--s4);
    padding: var(--s4) var(--s6);
    border-bottom: 1px solid var(--border);
    transition: background var(--ease-fast);
    animation: fadeIn 0.4s ease forwards;
  }

  .alert-item:last-child { border-bottom: none; }
  .alert-item:hover { background: var(--bg-soft); }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .alert-severity-icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .alert-severity-icon.HIGH {
    background: var(--risk-high-bg);
    color: var(--risk-high);
  }

  .alert-severity-icon.MODERATE {
    background: var(--risk-mod-bg);
    color: var(--risk-mod);
  }

  .alert-severity-icon.LOW {
    background: var(--risk-low-bg);
    color: var(--risk-low);
  }

  .alert-body { flex: 1; min-width: 0; }

  .alert-header {
    display: flex;
    align-items: center;
    gap: var(--s3);
    margin-bottom: 4px;
    flex-wrap: wrap;
  }

  .alert-location {
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--text-navy);
    white-space: nowrap;
  }

  .alert-state {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    letter-spacing: 0.06em;
  }

  .alert-message {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .alert-meta {
    display: flex;
    align-items: center;
    gap: var(--s3);
    margin-top: 4px;
    flex-wrap: wrap;
  }

  .alert-time {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--text-light);
    letter-spacing: 0.06em;
  }

  .alert-coords {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--text-light);
    letter-spacing: 0.04em;
  }

  /* Skeleton */
  .alert-skeleton {
    height: 64px;
    background: linear-gradient(90deg, var(--bg-soft) 25%, var(--bg-muted) 50%, var(--bg-soft) 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
    margin: var(--s2) var(--s6);
    border-radius: var(--r-md);
  }

  @keyframes shimmer {
    0%   { background-position: -200% 0; }
    100% { background-position:  200% 0; }
  }

  /* Disclaimer */
  .alerts-disclaimer {
    display: flex;
    align-items: flex-start;
    gap: var(--s3);
    padding: var(--s4) var(--s6);
    background: var(--risk-mod-bg);
    border-top: 1px solid var(--risk-mod-border);
    font-size: var(--text-xs);
    color: #7C2D12;
    line-height: 1.6;
  }

  .alerts-disclaimer svg { flex-shrink: 0; margin-top: 1px; }

  /* Error state */
  .alerts-error {
    padding: var(--s8) var(--s6);
    text-align: center;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
</style>

<script>
  (() => {
    const list = document.getElementById('alerts-list');
    const badge = document.getElementById('alerts-live-badge');
    const timestamp = document.getElementById('alerts-timestamp');

    const severityIcon = (s: string) => {
      if (s === 'HIGH') return '🔴';
      if (s === 'MODERATE') return '🟠';
      return '→';
    };

    const formatTime = (ts: string) => {
      try {
        const d = new Date(ts);
        return d.toLocaleTimeString('en-IN', { timeZone: 'Asia/Kolkata', hour: '2-digit', minute: '2-digit' }) + ' IST';
      } catch { return ts; }
    };

    fetch('https://backend-malaivizhi2-0.onrender.com/api/alerts', { signal: AbortSignal.timeout(10000) })
      .then(r => r.json())
      .then(data => {
        if (!list) return;
        list.innerHTML = '';

        // Update badge
        if (badge) {
          badge.innerHTML = `<span class="badge-dot"></span>${data.length} ACTIVE ALERTS`;
          badge.className = 'badge badge-live';
        }
        if (timestamp) timestamp.textContent = `Last fetched: ${new Date().toLocaleTimeString('en-IN')} IST`;

        if (!Array.isArray(data) || data.length === 0) {
          list.innerHTML = '<div class="alerts-error">No active alerts at this time.</div>';
          return;
        }

        data.forEach((alert, i) => {
          const item = document.createElement('div');
          item.className = 'alert-item';
          item.style.animationDelay = `${i * 0.06}s`;
          item.innerHTML = `
            <div class="alert-severity-icon ${alert.severity}">${severityIcon(alert.severity)}</div>
            <div class="alert-body">
              <div class="alert-header">
                <span class="alert-location">${alert.location_name}</span>
                <span class="alert-state">${alert.location_state}</span>
                <span class="badge badge-risk-${alert.severity.toLowerCase()}">${alert.severity}</span>
              </div>
              <p class="alert-message">${alert.message}</p>
              <div class="alert-meta">
                <span class="alert-time">${formatTime(alert.timestamp)}</span>
                <span class="alert-coords">${alert.latitude.toFixed(4)}°N ${alert.longitude.toFixed(4)}°E</span>
                <span class="badge badge-unavail">CONFIDENCE: LIMITED</span>
              </div>
            </div>
          `;
          list.appendChild(item);
        });
      })
      .catch(() => {
        if (list) list.innerHTML = '<div class="alerts-error">Unable to load alerts from backend — DEMO MODE. Backend may be starting up (Render free tier).</div>';
        if (badge) { badge.innerHTML = '<span class="badge-dot"></span>DEMO MODE'; badge.className = 'badge badge-limited'; }
      });
  })();
</script>
