---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import LiveAlertsFeed from '../components/LiveAlertsFeed.astro';
import CitizenReportsFeed from '../components/CitizenReportsFeed.astro';
import HistoricalEvents from '../components/HistoricalEvents.astro';
import GISMapSection from '../components/GISMapSection.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import TechGlossary from '../components/TechGlossary.astro';
---

<BaseLayout
  title="MALAI VIZHI — Landslide Risk Monitoring & Early Warning | Team HIVE"
  description="MALAI VIZHI is a premium landslide risk monitoring and early-warning platform for the North Eastern Region of India. Multi-factor risk analysis, GIS mapping, citizen reporting, real-time alerts."
>
  <Navigation slot="nav" />

  <!-- ═══════════════════════════════════════════════════════════
    HERO SECTION
  ═══════════════════════════════════════════════════════════ -->
  <section class="hero-section" id="home" aria-label="MALAI VIZHI introduction">
    <!-- Terrain background canvas -->
    <canvas class="hero-canvas" id="hero-canvas" aria-hidden="true"></canvas>

    <!-- Topographic overlay lines -->
    <div class="hero-topo-overlay" aria-hidden="true">
      <svg viewBox="0 0 1440 600" fill="none" preserveAspectRatio="xMidYMid slice">
        <path d="M-100 500 Q200 420 400 450 Q600 480 800 380 Q1000 280 1200 320 Q1400 360 1600 280" stroke="rgba(45,106,79,0.12)" stroke-width="1.5" fill="none"/>
        <path d="M-100 540 Q200 460 400 490 Q600 520 800 420 Q1000 320 1200 360 Q1400 400 1600 320" stroke="rgba(45,106,79,0.08)" stroke-width="1" fill="none"/>
        <path d="M-100 460 Q200 380 400 410 Q600 440 800 340 Q1000 240 1200 280 Q1400 320 1600 240" stroke="rgba(45,106,79,0.08)" stroke-width="1" fill="none"/>
        <path d="M-100 400 Q300 300 500 340 Q700 380 900 260 Q1100 140 1300 200 Q1500 260 1700 180" stroke="rgba(45,106,79,0.06)" stroke-width="0.75" fill="none"/>
        <path d="M-100 580 Q400 500 700 520 Q1000 540 1300 480 Q1600 420 1800 460" stroke="rgba(45,106,79,0.06)" stroke-width="0.75" fill="none"/>
        <!-- Grid dots -->
        <circle cx="200" cy="350" r="2" fill="rgba(45,106,79,0.15)"/>
        <circle cx="400" cy="280" r="2" fill="rgba(45,106,79,0.15)"/>
        <circle cx="650" cy="310" r="3" fill="rgba(185,28,28,0.3)"/>
        <circle cx="900" cy="240" r="2" fill="rgba(45,106,79,0.15)"/>
        <circle cx="1100" cy="290" r="2" fill="rgba(45,106,79,0.15)"/>
        <circle cx="1350" cy="220" r="2.5" fill="rgba(180,83,9,0.3)"/>
        <!-- Monitoring point pulses -->
        <circle cx="650" cy="310" r="8" stroke="rgba(185,28,28,0.25)" stroke-width="1" fill="none" class="hero-pulse-1"/>
        <circle cx="650" cy="310" r="16" stroke="rgba(185,28,28,0.12)" stroke-width="0.75" fill="none" class="hero-pulse-2"/>
        <circle cx="1350" cy="220" r="8" stroke="rgba(180,83,9,0.25)" stroke-width="1" fill="none" class="hero-pulse-1"/>
        <circle cx="1350" cy="220" r="16" stroke="rgba(180,83,9,0.12)" stroke-width="0.75" fill="none" class="hero-pulse-2"/>
      </svg>
    </div>

    <div class="container">
      <div class="hero-inner">
        <!-- Left content -->
        <div class="hero-content gsap-reveal-up">
          <!-- Label -->
          <div class="hero-label">
            <span class="hero-label-tag">TEAM HIVE</span>
            <span class="hero-label-divider" aria-hidden="true">·</span>
            <span class="hero-label-text">LANDSLIDE RISK MONITORING & EARLY WARNING</span>
          </div>

          <!-- Main title -->
          <h1 class="hero-title" aria-label="MALAI VIZHI">
            <span class="hero-title-main">MALAI</span>
            <span class="hero-title-main hero-title-accent">VIZHI</span>
          </h1>

          <!-- Tagline -->
          <p class="hero-tagline">Seeing the Risk Before the Landslide.</p>

          <!-- Description -->
          <p class="hero-desc">
            MALAI VIZHI is a location-based landslide risk monitoring and early-warning platform designed to combine environmental, terrain, historical and ground-level information into an understandable risk assessment for communities and authorities in the <strong>North Eastern Region of India</strong>.
          </p>

          <!-- CTA Buttons -->
          <div class="hero-actions">
            <a href="#how-it-works" class="btn-primary" id="hero-btn-explore">
              <span>Explore MALAI VIZHI</span>
              <svg class="btn-arrow" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            <a href="#risk-engine" class="btn-outline" id="hero-btn-risk">
              <span>View Risk Engine</span>
              <svg class="btn-arrow" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            <a href="https://backend-malaivizhi2-0.onrender.com/api/health" class="btn-technical" target="_blank" rel="noopener" id="hero-btn-api">
              <svg width="8" height="8" viewBox="0 0 8 8" fill="none" aria-hidden="true">
                <circle cx="4" cy="4" r="3" fill="currentColor"/>
              </svg>
              LIVE API STATUS
            </a>
          </div>

          <!-- Technical status strip -->
          <div class="hero-status-strip" role="list" aria-label="System capabilities">
            <div class="hero-status-item" role="listitem">
              <span class="hero-status-dot green" aria-hidden="true"></span>
              <span>MULTI-SOURCE DATA</span>
            </div>
            <div class="hero-status-item" role="listitem">
              <span class="hero-status-dot green" aria-hidden="true"></span>
              <span>GIS MONITORING</span>
            </div>
            <div class="hero-status-item" role="listitem">
              <span class="hero-status-dot green" aria-hidden="true"></span>
              <span>EXPLAINABLE RISK</span>
            </div>
            <div class="hero-status-item" role="listitem">
              <span class="hero-status-dot" id="hero-system-dot" aria-hidden="true"></span>
              <span id="hero-system-status">SYSTEM DEMO</span>
            </div>
          </div>
        </div>

        <!-- Right — Live dashboard panel -->
        <div class="hero-panel gsap-reveal-right">
          <div class="hero-panel-header">
            <span class="hero-panel-title">SYSTEM OVERVIEW</span>
            <span class="badge badge-limited" id="hero-panel-badge">
              <span class="badge-dot"></span>LIMITED DATA
            </span>
          </div>

          <!-- Live numbers from API -->
          <div class="hero-stats-grid">
            <div class="hero-stat">
              <div class="hero-stat-num" id="stat-alerts">—</div>
              <div class="hero-stat-label">Active Alerts</div>
              <span class="badge badge-live" style="margin-top: 4px; font-size: 0.55rem;">REAL-TIME</span>
            </div>
            <div class="hero-stat">
              <div class="hero-stat-num" id="stat-events">3</div>
              <div class="hero-stat-label">Historical Events</div>
              <span class="badge badge-historical" style="margin-top: 4px; font-size: 0.55rem;">VERIFIED</span>
            </div>
            <div class="hero-stat">
              <div class="hero-stat-num" id="stat-reports">—</div>
              <div class="hero-stat-label">Ground Reports</div>
              <span class="badge badge-demo" style="margin-top: 4px; font-size: 0.55rem;">CITIZEN</span>
            </div>
            <div class="hero-stat">
              <div class="hero-stat-num">0</div>
              <div class="hero-stat-label">Live Sensors</div>
              <span class="badge badge-unavail" style="margin-top: 4px; font-size: 0.55rem;">SENSOR-READY</span>
            </div>
          </div>

          <!-- Coverage regions -->
          <div class="hero-coverage">
            <p class="hero-coverage-label">COVERAGE AREA · NER INDIA</p>
            <div class="hero-regions">
              {['Meghalaya','Assam','Nagaland','Manipur','Mizoram','Tripura','Arunachal Pradesh','Sikkim'].map(r => (
                <span class="hero-region-tag">{r}</span>
              ))}
            </div>
          </div>

          <!-- Mini risk scale -->
          <div class="hero-risk-scale">
            <p class="hero-coverage-label" style="margin-bottom: 8px;">RISK CLASSIFICATION SCALE</p>
            <div class="hero-risk-bar-wrap">
              <div class="hero-risk-bar"></div>
              <div class="hero-risk-labels">
                <span>LOW</span>
                <span>MODERATE</span>
                <span>HIGH</span>
              </div>
              <div class="hero-risk-values">
                <span>0</span>
                <span>50</span>
                <span>75</span>
                <span>100</span>
              </div>
            </div>
          </div>

          <p class="hero-panel-note">
            Environmental risk assessment based on multi-factor analysis.
            Not a guaranteed landslide prediction.
          </p>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="hero-scroll-indicator" aria-hidden="true">
      <div class="hero-scroll-line"></div>
      <span>SCROLL TO EXPLORE</span>
    </div>
  </section>

  <hr class="section-divider" />

  <!-- ═══════════════════════════════════════════════════════════
    SECTION 01 — THE PROBLEM
  ═══════════════════════════════════════════════════════════ -->
  <section class="section-lg topo-bg" id="problem" aria-labelledby="problem-title">
    <div class="container">
      <div class="section-label"><span class="section-label-text">SECTION 01 / THE PROBLEM</span></div>
      <div class="problem-grid">
        <div class="problem-intro gsap-reveal-up">
          <h2 class="display-lg" id="problem-title">
            Why Landslide Risk Requires More Than Rainfall Monitoring.
          </h2>
          <p class="body-lg" style="margin-top: var(--s6);">
            The North Eastern Region of India contains steep mountainous terrain, rainfall-sensitive environments, and scattered communities and infrastructure. Understanding when and where landslide conditions are elevated requires combining multiple environmental factors — not a single sensor.
          </p>
          <div class="problem-region-note">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.25"/>
              <path d="M8 5v4M8 10.5v.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
            </svg>
            <span>Focus Region: North Eastern India · Assam, Meghalaya, Nagaland, Manipur, Mizoram, Tripura, Arunachal Pradesh, Sikkim</span>
          </div>
        </div>

        <div class="problem-cards-grid">
          {[
            {
              num: '01',
              title: 'Heavy Rainfall',
              icon: '🌧',
              desc: 'Sustained or intense rainfall can increase water infiltration and ground saturation. Cumulative rainfall over hours and days is often more significant than a single peak event.',
              factor: 'RAINFALL INTENSITY & ACCUMULATION',
              color: 'blue',
            },
            {
              num: '02',
              title: 'Saturated Soil',
              icon: '🌱',
              desc: 'Increasing soil moisture can reduce slope stability depending on local terrain conditions. High soil moisture reduces the shear strength of soil — a key factor in slope failure.',
              factor: 'SOIL MOISTURE LEVEL',
              color: 'amber',
            },
            {
              num: '03',
              title: 'Steep Terrain',
              icon: '⛰',
              desc: 'Terrain slope is a fundamental factor in landslide susceptibility. The angle of a slope determines the gravitational stress on overlying soil and rock layers.',
              factor: 'SLOPE & TERRAIN ANGLE',
              color: 'green',
            },
            {
              num: '04',
              title: 'Limited Ground Information',
              icon: '📡',
              desc: 'Remote or difficult terrain can make continuous monitoring and rapid verification challenging. MALAI VIZHI is designed with a sensor-ready architecture to address this incrementally.',
              factor: 'OBSERVATIONAL GAPS',
              color: 'red',
            },
          ].map(card => (
            <div class={`problem-card problem-card--${card.color} gsap-reveal-up`} tabindex="0" role="article" aria-label={`Problem: ${card.title}`}>
              <div class="problem-card-header">
                <span class="problem-card-num" aria-hidden="true">{card.num}</span>
                <span class="problem-card-icon" aria-hidden="true">{card.icon}</span>
              </div>
              <h3 class="problem-card-title">{card.title}</h3>
              <p class="problem-card-desc">{card.desc}</p>
              <div class="problem-card-factor">
                <span class="problem-card-factor-text">{card.factor}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <hr class="section-divider" />

  <!-- ═══════════════════════════════════════════════════════════
    SECTION 02 — THE SOLUTION / HOW IT WORKS
  ═══════════════════════════════════════════════════════════ -->
  <section class="section-lg" id="how-it-works" aria-labelledby="solution-title">
    <div class="container">
      <div class="section-label"><span class="section-label-text">SECTION 02 / THE SOLUTION</span></div>
      <h2 class="display-lg gsap-reveal-up" id="solution-title">
        One System. Multiple Sources. One Clear View.
      </h2>
      <p class="body-lg gsap-reveal-up" style="margin-top: var(--s5); max-width: 680px;">
        MALAI VIZHI connects environmental data, terrain information, ground observations and historical context into a single explainable risk pipeline — from raw measurement to early warning.
      </p>

      <!-- Pipeline interactive -->
      <div class="pipeline-wrap gsap-scale" style="margin-top: var(--s12);">
        <div class="pipeline-stages" id="pipeline-stages" role="list">
          {[
            {
              id: 'collect',
              num: '01',
              icon: '📡',
              title: 'COLLECT',
              short: 'Multi-source data ingestion',
              detail: 'The system collects data from multiple sources: rainfall measurements from Open-Meteo, soil moisture estimations from ERA5-Land, terrain elevation from Copernicus DEM, historical landslide susceptibility from GSI datasets, citizen reports from the mobile/web platform, and telemetry from ground sensors where deployed. Not every source is always available — the system tracks data completeness explicitly.'
            },
            {
              id: 'process',
              num: '02',
              icon: '⚙',
              title: 'PROCESS',
              short: 'Validation & normalization',
              detail: 'Raw measurements are validated for freshness, format, and plausibility. Each measurement is normalized from its native unit (mm, %, degrees) into a comparable factor score using calibrated functions. Data staleness, source availability, and quality are tracked. The system never invents or interpolates missing data — missing sources are explicitly marked as UNAVAILABLE.'
            },
            {
              id: 'assess',
              num: '03',
              icon: '🔬',
              title: 'ASSESS',
              short: 'Multi-factor risk analysis',
              detail: 'Normalized factor scores are combined using configured weights into a single 0–100 risk score. The dominant factor (the one contributing most to the score) is identified. Risk level (LOW / MODERATE / HIGH) is determined by applying classification thresholds. Overall confidence is computed from data completeness and freshness. The full factor breakdown is preserved for explainability.'
            },
            {
              id: 'warn',
              num: '04',
              icon: '🔔',
              title: 'WARN',
              short: 'Location-based early warning',
              detail: 'When risk scores exceed configured thresholds, the alert engine generates a location-specific warning. Alerts include the location, severity, contributing factors, confidence level, timestamp, and coordinates. Notifications are delivered via web push and Android notifications. SMS delivery requires an external provider configured at deployment. The system logs all alerts.'
            },
            {
              id: 'respond',
              num: '05',
              icon: '🧭',
              title: 'RESPOND',
              short: 'Authority & community action',
              detail: 'Alerts are delivered to configured authorities and affected communities. The authority dashboard provides detailed factor breakdowns, GIS context, citizen report evidence, and route risk information. Authorities can verify, acknowledge, and act on alerts. Citizens can submit additional ground observations. High-risk situations still require physical verification — the system supports, not replaces, human decision-making.'
            },
          ].map((stage, i) => (
            <div
              class="pipeline-stage"
              id={`pipeline-stage-${stage.id}`}
              data-stage={stage.id}
              role="listitem button"
              tabindex="0"
              aria-expanded="false"
              aria-controls={`pipeline-detail-${stage.id}`}
            >
              <div class="pipeline-stage-inner">
                <span class="pipeline-stage-num" aria-hidden="true">{stage.num}</span>
                <span class="pipeline-stage-icon" aria-hidden="true">{stage.icon}</span>
                <span class="pipeline-stage-title">{stage.title}</span>
                <span class="pipeline-stage-short">{stage.short}</span>
              </div>
              {i < 4 && (
                <div class="pipeline-arrow" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                    <path d="M5 10h10M12 7l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
              )}
            </div>
          ))}
        </div>

        <!-- Expandable detail panels -->
        <div class="pipeline-details" id="pipeline-details">
          {[
            { id: 'collect', title: '01 COLLECT — DATA INGESTION', content: 'The system collects data from multiple sources: rainfall measurements from Open-Meteo, soil moisture estimations from ERA5-Land, terrain elevation from Copernicus DEM, historical landslide susceptibility from GSI datasets, citizen reports from the mobile/web platform, and telemetry from ground sensors where deployed. Not every source is always available — the system tracks data completeness explicitly.' },
            { id: 'process', title: '02 PROCESS — VALIDATION & NORMALIZATION', content: 'Raw measurements are validated for freshness, format, and plausibility. Each measurement is normalized from its native unit (mm, %, degrees) into a comparable factor score using calibrated functions. Data staleness, source availability, and quality are tracked. The system never invents or interpolates missing data — missing sources are explicitly marked as UNAVAILABLE.' },
            { id: 'assess', title: '03 ASSESS — MULTI-FACTOR RISK ANALYSIS', content: 'Normalized factor scores are combined using configured weights into a single 0–100 risk score. The dominant factor (the one contributing most to the score) is identified. Risk level (LOW / MODERATE / HIGH) is determined by applying classification thresholds. Overall confidence is computed from data completeness and freshness. The full factor breakdown is preserved for explainability.' },
            { id: 'warn', title: '04 WARN — LOCATION-BASED EARLY WARNING', content: 'When risk scores exceed configured thresholds, the alert engine generates a location-specific warning. Alerts include the location, severity, contributing factors, confidence level, timestamp, and coordinates. Notifications are delivered via web push and Android notifications. SMS delivery requires an external provider configured at deployment.' },
            { id: 'respond', title: '05 RESPOND — AUTHORITY & COMMUNITY ACTION', content: 'Alerts are delivered to configured authorities and affected communities. The authority dashboard provides detailed factor breakdowns, GIS context, citizen report evidence, and route risk information. Authorities can verify, acknowledge, and act on alerts. Citizens can submit additional ground observations. High-risk situations still require physical verification.' },
          ].map(detail => (
            <div class="pipeline-detail" id={`pipeline-detail-${detail.id}`} aria-hidden="true">
              <div class="pipeline-detail-inner">
                <h3 class="pipeline-detail-title">{detail.title}</h3>
                <p class="pipeline-detail-content">{detail.content}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <hr class="section-divider" />

  <!-- ═══════════════════════════════════════════════════════════
    SECTION 03 & 04 — DATA SOURCES
  ═══════════════════════════════════════════════════════════ -->
  <section class="section-dark topo-bg-dark section-lg" id="data" aria-labelledby="data-title">
    <div class="container">
      <div class="section-label dark"><span class="section-label-text">SECTION 03 / DATA SOURCES</span></div>
      <h2 class="display-lg gsap-reveal-up" id="data-title">
        The System Does Not Depend on One Signal.
      </h2>
      <p class="body-lg gsap-reveal-up" style="margin-top: var(--s5); max-width: 640px;">
        Seven data categories feed the risk engine. Each source has different availability, quality, and coverage. The system is transparent about what is available and what is not.
      </p>

      <div class="data-sources-grid" style="margin-top: var(--s12);">
        {[
          {
            icon: '🌧',
            title: 'Rainfall Data',
            provider: 'Open-Meteo ERA5 / NWP',
            what: 'Precipitation measurements in mm per hour and per 24 hours',
            why: 'Rainfall is the primary trigger for most landslides in NER India',
            how: 'Hourly and 24-hour accumulation → normalized → rainfall factor score',
            avail: 'limited',
            availLabel: 'LIMITED / API-DEPENDENT',
          },
          {
            icon: '🌱',
            title: 'Soil Moisture',
            provider: 'Open-Meteo ERA5-Land',
            what: 'Volumetric soil water content at surface layer, % value',
            why: 'High soil moisture reduces slope stability — key factor in failure threshold',
            how: 'Volumetric % → normalized → soil-moisture factor score',
            avail: 'modeled',
            availLabel: 'MODELED / ESTIMATED',
          },
          {
            icon: '🗻',
            title: 'Terrain & Slope',
            provider: 'Copernicus Global DEM (GLO-30)',
            what: 'Elevation values at ~30m resolution for deriving slope angle',
            why: 'Slope angle determines gravitational stress on soil layers',
            how: 'DEM elevation grid → spatial gradient → slope angle (degrees) → normalized',
            avail: 'historical',
            availLabel: 'STATIC DEM / ON-DEMAND',
          },
          {
            icon: '📚',
            title: 'Historical Landslide Data',
            provider: 'GSI Inventory · NRSC · SDMA',
            what: 'Records of previous landslide events with location and severity',
            why: 'Historical events indicate terrain susceptibility zones',
            how: 'Spatial lookup → historical hazard factor score',
            avail: 'live',
            availLabel: 'AVAILABLE',
          },
          {
            icon: '🗺',
            title: 'GIS / Exposure Data',
            provider: 'GIS Datasets (Demo)',
            what: 'Village locations, road networks, infrastructure, population estimates',
            why: 'Exposure determines impact priority — who and what is in the hazard zone',
            how: 'Spatial overlap of hazard zone → exposure score → impact priority',
            avail: 'demo',
            availLabel: 'DEMO DATA',
          },
          {
            icon: '📡',
            title: 'Ground Sensor Telemetry',
            provider: 'Sensor-Ready Architecture',
            what: 'Rainfall gauge, soil probe, inclinometer, GPS, battery, timestamp',
            why: 'Direct physical observation provides ground truth for models',
            how: 'Sensor JSON → validate → real-time factor score update',
            avail: 'unavail',
            availLabel: 'SENSOR-READY / NOT DEPLOYED',
          },
          {
            icon: '👥',
            title: 'Citizen Reports',
            provider: 'MALAI VIZHI Platform',
            what: 'Ground observations submitted by users: photos, GPS, category, description',
            why: 'Crowdsourced ground truth that sensors cannot always provide',
            how: 'Report → verify → evidence log (does NOT directly alter risk score)',
            avail: 'live',
            availLabel: 'LIVE — 2 REPORTS ON RECORD',
          },
        ].map(src => (
          <div class={`data-source-card gsap-reveal-up`} tabindex="0" role="article">
            <div class="data-source-header">
              <span class="data-source-icon" aria-hidden="true">{src.icon}</span>
              <div>
                <h3 class="data-source-title">{src.title}</h3>
                <p class="data-source-provider">{src.provider}</p>
              </div>
              <span class={`badge badge-${src.avail}`}>{src.availLabel}</span>
            </div>
            <div class="data-source-details">
              <div class="data-source-row">
                <span class="data-source-key">WHAT</span>
                <span class="data-source-val">{src.what}</span>
              </div>
              <div class="data-source-row">
                <span class="data-source-key">WHY</span>
                <span class="data-source-val">{src.why}</span>
              </div>
              <div class="data-source-row">
                <span class="data-source-key">HOW USED</span>
                <span class="data-source-val">{src.how}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <hr class="section-divider" />

  <!-- ═══════════════════════════════════════════════════════════
    SECTION 05 — TERRAIN: FROM ELEVATION TO SLOPE
  ═══════════════════════════════════════════════════════════ -->
  <section class="section-lg" id="terrain" aria-labelledby="terrain-title">
    <div class="container">
      <div class="section-label"><span class="section-label-text">SECTION 05 / TERRAIN ANALYSIS</span></div>
      <div class="terrain-grid">
        <div class="gsap-reveal-up">
          <h2 class="display-lg" id="terrain-title">From Elevation to Slope.</h2>
          <p class="body-lg" style="margin-top: var(--s6); max-width: 520px;">
            MALAI VIZHI does not require manual surveying of every hillside. Slope is computed programmatically from Digital Elevation Model data provided by Copernicus.
          </p>
