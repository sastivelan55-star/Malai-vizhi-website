  height: 8px;
  border-radius: var(--r-full);
  background: linear-gradient(to right, #93C5FD, #3B82F6, #1D4ED8, #1E3A5F);
}

.dem-calc-note {
  font-size: var(--text-xs);
  color: var(--text-secondary);
  line-height: 1.75;
  background: var(--bg-soft);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  padding: var(--s4);
}

/* ══════════════════════════ ENVIRONMENT SECTION ══════════════════════════ */
.env-chain-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--s12);
}

@media (max-width: 900px) { .env-chain-grid { grid-template-columns: 1fr; } }

.env-chain { display: flex; flex-direction: column; gap: 0; }

.env-chain-node {
  display: flex;
  align-items: flex-start;
  gap: var(--s5);
  padding: var(--s4) 0;
}

.env-chain-icon {
  width: 48px;
  height: 48px;
  border-radius: var(--r-lg);
  border: 1.5px solid;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.25rem;
  flex-shrink: 0;
}

.env-chain-body { flex: 1; }
.env-chain-label { font-family: var(--font-mono); font-size: var(--text-sm); font-weight: 700; letter-spacing: 0.10em; text-transform: uppercase; display: block; margin-bottom: 4px; }
.env-chain-desc { font-size: var(--text-sm); color: rgba(255,255,255,0.65); line-height: 1.65; }
.env-chain-arrow { font-size: var(--text-2xl); color: rgba(255,255,255,0.2); padding: var(--s1) var(--s6); display: block; }

.env-side-notes { display: flex; flex-direction: column; gap: var(--s5); }

.env-side-note {
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.10);
  border-radius: var(--r-xl);
  padding: var(--s5);
}

.env-side-note p { font-size: var(--text-sm); color: rgba(255,255,255,0.70); line-height: 1.75; }
.env-side-note strong { color: white; }

.rainfall-canvas-wrap {
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.10);
  border-radius: var(--r-xl);
  padding: var(--s4);
  overflow: hidden;
  text-align: center;
}

#rainfall-canvas { border-radius: var(--r-lg); display: block; margin: 0 auto; background: rgba(255,255,255,0.05); }

/* ══════════════════════════ RISK ENGINE ══════════════════════════ */
.engine-explainer {
  background: var(--bg-white);
  border: 1px solid var(--border);
  border-radius: var(--r-xl);
  overflow: hidden;
}

.engine-explainer-header {
  padding: var(--s4) var(--s6);
  background: var(--bg-soft);
  border-bottom: 1px solid var(--border);
}

.engine-explainer-body {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  padding: var(--s6);
  gap: var(--s6);
}

@media (max-width: 768px) { .engine-explainer-body { grid-template-columns: 1fr; } }

.engine-explain-label {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: 700;
  letter-spacing: 0.10em;
  text-transform: uppercase;
  margin-bottom: var(--s4);
}

.engine-formula {
  display: flex;
  flex-wrap: wrap;
  gap: var(--s2);
  align-items: center;
  background: var(--bg-soft);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  padding: var(--s4);
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: 600;
  margin-bottom: var(--s4);
}

.engine-formula.bad { border-color: var(--risk-high-border); background: var(--risk-high-bg); color: #7F1D1D; }
.engine-formula.good { border-color: var(--risk-low-border); background: var(--risk-low-bg); color: #14532D; }
.formula-result { color: var(--green-primary); font-weight: 800; font-size: var(--text-sm); }

.engine-explain-note { font-size: var(--text-xs); color: var(--text-muted); line-height: 1.6; }

.factors-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
  gap: var(--s5);
}

.factor-card {
  background: var(--bg-white);
  border: 1px solid var(--border);
  border-radius: var(--r-xl);
  padding: var(--s5);
  box-shadow: var(--shadow-sm);
}

.factor-card-header { display: flex; align-items: flex-start; gap: var(--s3); margin-bottom: var(--s4); }
.factor-card-icon { font-size: 1.5rem; }
.factor-card-title { font-weight: 700; font-size: var(--text-sm); color: var(--text-navy); margin-bottom: 4px; }
.factor-card-values { display: flex; align-items: center; gap: var(--s3); margin-bottom: var(--s3); }
.factor-val-pair { display: flex; flex-direction: column; gap: 2px; }
.factor-val-key { font-family: var(--font-mono); font-size: 0.6rem; font-weight: 700; letter-spacing: 0.10em; text-transform: uppercase; color: var(--text-muted); }
.factor-val-num { font-family: var(--font-mono); font-size: var(--text-base); font-weight: 700; color: var(--text-navy); }
.factor-val-num.green { color: var(--green-primary); }
.factor-card-why { font-size: var(--text-xs); color: var(--text-secondary); line-height: 1.6; margin-top: var(--s3); margin-bottom: var(--s3); }
.factor-card-footer { display: flex; align-items: center; gap: var(--s3); flex-wrap: wrap; }

/* ══════════════════════════ SIMULATOR ══════════════════════════ */
.sim-outer-label { display: flex; gap: var(--s3); flex-wrap: wrap; margin-top: var(--s5); }

.simulator-wrap {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--s8);
  background: var(--bg-white);
  border: 1px solid var(--border);
  border-radius: var(--r-2xl);
  padding: var(--s8);
  box-shadow: var(--shadow-lg);
}

@media (max-width: 900px) { .simulator-wrap { grid-template-columns: 1fr; } }

.simulator-controls-title {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--text-navy);
  margin-bottom: 4px;
}

.simulator-controls-sub {
  font-size: var(--text-xs);
  color: var(--text-muted);
  margin-bottom: var(--s6);
  font-style: italic;
}

.slider-group { display: flex; flex-direction: column; gap: var(--s5); }

.slider-item { display: flex; flex-direction: column; gap: var(--s2); }

.slider-label-row { display: flex; justify-content: space-between; align-items: center; }

.slider-label {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--text-navy);
}

.slider-val {
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  font-weight: 700;
  color: var(--green-primary);
}

.sim-slider {
  width: 100%;
  height: 6px;
  border-radius: var(--r-full);
  outline: none;
  -webkit-appearance: none;
  background: linear-gradient(to right, var(--green-light) 0%, var(--green-light) var(--pct, 50%), var(--bg-muted) var(--pct, 50%), var(--bg-muted) 100%);
  cursor: pointer;
}

.sim-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: var(--green-primary);
  border: 2px solid white;
  box-shadow: var(--shadow-sm);
  cursor: pointer;
}

.factor-breakdown { margin-top: var(--s6); display: flex; flex-direction: column; gap: var(--s3); }

/* Risk meter display */
.simulator-display { display: flex; flex-direction: column; align-items: center; gap: var(--s5); }

.risk-meter-wrap { display: flex; flex-direction: column; align-items: center; gap: var(--s4); width: 100%; }

.risk-arc-svg { width: 200px; height: 120px; overflow: visible; }

.risk-arc-track { fill: none; stroke: var(--bg-muted); stroke-width: 14; stroke-linecap: round; }
.risk-arc-fill  { fill: none; stroke-width: 14; stroke-linecap: round; stroke-dasharray: 251; stroke-dashoffset: 251; transition: stroke-dashoffset 1s cubic-bezier(0.4,0,0.2,1), stroke 0.5s; }

.risk-score-display { text-align: center; }
.risk-score-num { font-family: var(--font-display); font-size: var(--text-7xl); font-weight: 800; letter-spacing: -0.05em; color: var(--text-navy); line-height: 1; }
.risk-level-badge { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-muted); margin-top: 4px; }

.risk-meter-label { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); text-align: center; }

/* Confidence display */
.confidence-display { width: 100%; }
.confidence-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--s3); }
.confidence-label { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-navy); }
.confidence-note { font-size: var(--text-xs); color: var(--text-muted); font-style: italic; }

.confidence-bar-wrap { display: flex; align-items: center; gap: var(--s3); margin-bottom: var(--s3); }
.confidence-bar-track { flex: 1; height: 8px; background: var(--bg-muted); border-radius: var(--r-full); overflow: hidden; }
.confidence-bar-fill { height: 100%; background: var(--status-limited); border-radius: var(--r-full); transition: width 0.6s ease, background 0.3s ease; }
.confidence-pct { font-family: var(--font-mono); font-size: var(--text-sm); font-weight: 700; color: var(--status-limited); }
.confidence-explanation { font-size: var(--text-xs); color: var(--text-muted); line-height: 1.6; }

.sim-disclaimer {
  font-size: var(--text-xs);
  color: var(--status-limited);
  background: var(--risk-mod-bg);
  border: 1px solid var(--risk-mod-border);
  border-radius: var(--r-lg);
  padding: var(--s3) var(--s4);
  text-align: center;
  line-height: 1.5;
  width: 100%;
}

/* ══════════════════════════ EXPLAINABILITY ══════════════════════════ */
.explain-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--s8);
}

.risk-score-summary { display: flex; align-items: center; gap: var(--s5); margin-bottom: var(--s6); }
.risk-score-big { font-family: var(--font-display); font-size: var(--text-8xl); font-weight: 800; letter-spacing: -0.05em; color: var(--risk-mod); line-height: 1; }

.explain-factor-row {
  padding: var(--s4) 0;
  border-bottom: 1px solid var(--border);
}

.explain-factor-row:last-child { border-bottom: none; }

.explain-factor-top { display: flex; align-items: center; gap: var(--s3); flex-wrap: wrap; margin-bottom: 6px; }
.explain-factor-name { font-weight: 600; font-size: var(--text-sm); color: var(--text-navy); }
.explain-factor-raw { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--text-muted); }
.explain-factor-note { font-size: 0.65rem; color: var(--text-muted); margin-top: 4px; font-style: italic; }

/* Confidence dual meters */
.confidence-dual-meters { display: grid; grid-template-columns: 1fr auto 1fr; gap: var(--s4); align-items: center; }
.confidence-meter-card { background: var(--bg-white); border: 1px solid var(--border); border-radius: var(--r-xl); padding: var(--s5); text-align: center; }
.confidence-meter-label { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); margin-bottom: var(--s3); display: block; }
.confidence-meter-value { font-family: var(--font-display); font-size: var(--text-5xl); font-weight: 800; letter-spacing: -0.04em; line-height: 1; margin-bottom: var(--s3); }
.confidence-meter-desc { font-size: var(--text-xs); color: var(--text-secondary); line-height: 1.6; margin-bottom: var(--s4); }
.confidence-meter-bar { height: 8px; background: var(--bg-muted); border-radius: var(--r-full); overflow: hidden; margin-bottom: var(--s4); }
.confidence-vs { font-family: var(--font-display); font-size: var(--text-4xl); font-weight: 800; color: var(--text-muted); text-align: center; }
@media (max-width: 640px) { .confidence-dual-meters { grid-template-columns: 1fr; } .confidence-vs { display: none; } }

/* ══════════════════════════ SENSORS ══════════════════════════ */
.sensor-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--s12);
}

@media (max-width: 900px) { .sensor-grid { grid-template-columns: 1fr; } }

.sensor-types { display: flex; flex-direction: column; gap: var(--s3); }

.sensor-type-item {
  display: flex;
  align-items: center;
  gap: var(--s4);
  padding: var(--s3) var(--s4);
  background: var(--bg-soft);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
}

.sensor-type-icon { font-size: 1.25rem; flex-shrink: 0; }
.sensor-type-name { font-weight: 600; font-size: var(--text-sm); color: var(--text-navy); }
.sensor-type-unit { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--text-muted); margin-left: 4px; }

.sensor-arch { background: var(--bg-soft); border: 1px solid var(--border); border-radius: var(--r-xl); padding: var(--s5); }
.sensor-arch-title { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); margin-bottom: var(--s4); }

/* Sensor failure */
.sensor-failure-panel {
  background: var(--bg-white);
  border: 1px solid var(--border);
  border-radius: var(--r-2xl);
  padding: var(--s8);
  box-shadow: var(--shadow-md);
}

.failure-demo { margin-top: var(--s6); }
.failure-steps { display: flex; flex-direction: column; gap: var(--s3); }

.failure-step {
  display: flex;
  align-items: flex-start;
  gap: var(--s4);
  padding: var(--s4);
  border-radius: var(--r-lg);
  border: 1px solid var(--border);
  background: var(--bg-soft);
  transition: all 0.4s ease;
}

.failure-step--normal  { }
.failure-step--warning { border-color: var(--risk-mod-border); background: var(--risk-mod-bg); }
.failure-step--error   { border-color: var(--risk-high-border); background: var(--risk-high-bg); }
.failure-step--info    { border-color: #BFDBFE; background: #EFF6FF; }
.failure-step--action  { border-color: var(--border-green); background: var(--green-bg); }

.failure-step-icon { font-size: 1.25rem; flex-shrink: 0; }
.failure-step-label { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.10em; text-transform: uppercase; color: var(--text-navy); display: block; margin-bottom: 2px; }
.failure-step-desc { font-size: var(--text-xs); color: var(--text-secondary); line-height: 1.6; }

/* ══════════════════════════ HISTORICAL / ALERTS ══════════════════════════ */
.historical-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--s10);
  align-items: flex-start;
}

@media (max-width: 900px) { .historical-grid { grid-template-columns: 1fr; } }

.alerts-main-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--s8);
}

@media (max-width: 900px) { .alerts-main-grid { grid-template-columns: 1fr; } }

.alert-flow-step {
  display: flex;
  align-items: flex-start;
  gap: var(--s4);
  padding: var(--s3) var(--s4);
  border-radius: var(--r-lg);
  background: var(--bg-soft);
  border: 1px solid var(--border);
}

.alert-flow-step--warn { border-color: var(--risk-mod-border); background: var(--risk-mod-bg); }
.alert-flow-icon { font-size: 1.25rem; flex-shrink: 0; }
.alert-flow-label { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.10em; text-transform: uppercase; color: var(--text-navy); display: block; margin-bottom: 2px; }
.alert-flow-desc { font-size: var(--text-xs); color: var(--text-secondary); line-height: 1.6; }

/* ══════════════════════════ ARCHITECTURE ══════════════════════════ */
.arch-diagram {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--s4);
}

@media (max-width: 1024px) { .arch-diagram { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 640px)  { .arch-diagram { grid-template-columns: 1fr; } }

.arch-layer {
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.10);
  border-radius: var(--r-xl);
  padding: var(--s5);
  position: relative;
  transition: all var(--ease-base);
}

.arch-layer:hover {
  background: rgba(255,255,255,0.09);
  border-color: rgba(255,255,255,0.20);
  transform: translateY(-4px);
}

.arch-layer-header { display: flex; align-items: center; gap: var(--s3); margin-bottom: var(--s4); }

.arch-layer-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--layer-color, white);
  flex-shrink: 0;
}

.arch-layer-title {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--layer-color, white);
}

.arch-layer-items { display: flex; flex-direction: column; gap: var(--s2); }

.arch-layer-item {
  font-size: var(--text-xs);
  color: rgba(255,255,255,0.65);
  padding: 3px 0;
  border-bottom: 1px solid rgba(255,255,255,0.05);
  display: flex;
  align-items: center;
  gap: var(--s2);
}

.arch-layer-item::before {
  content: '›';
  color: var(--layer-color, rgba(255,255,255,0.3));
  flex-shrink: 0;
}

.arch-layer-arrow { text-align: center; padding: var(--s2) 0; }

/* ══════════════════════════ TECH STACK ══════════════════════════ */
.tech-stack-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: var(--s5); }

.tech-stack-card { background: var(--bg-white); border: 1px solid var(--border); border-radius: var(--r-xl); padding: var(--s6); box-shadow: var(--shadow-sm); transition: all var(--ease-base); }
.tech-stack-card:hover { box-shadow: var(--shadow-lg); transform: translateY(-4px); }

.tech-stack-header { display: flex; align-items: center; gap: var(--s3); padding-bottom: var(--s4); border-bottom: 1px solid var(--border); margin-bottom: var(--s5); }
.tech-stack-icon { font-size: 1.5rem; }
.tech-stack-category { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-navy); }

.tech-stack-items { display: flex; flex-direction: column; gap: var(--s3); }
.tech-item { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s3); padding: var(--s2) 0; border-bottom: 1px solid var(--border); }
.tech-item:last-child { border-bottom: none; }
.tech-item-name { font-weight: 700; font-size: var(--text-sm); color: var(--text-navy); }
.tech-item-desc { font-size: var(--text-xs); color: var(--text-muted); text-align: right; }

/* ══════════════════════════ LIMITATIONS ══════════════════════════ */
.limitations-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 360px), 1fr)); gap: var(--s5); }

.limitation-card {
  background: var(--bg-white);
  border: 1px solid var(--border);
  border-radius: var(--r-xl);
  padding: var(--s6);
  transition: all var(--ease-base);
}

.limitation-card:hover { box-shadow: var(--shadow-md); transform: translateY(-3px); }

.limitation-card-header { display: flex; align-items: center; gap: var(--s4); margin-bottom: var(--s4); }
.limitation-num { font-family: var(--font-mono); font-size: var(--text-3xl); font-weight: 800; color: var(--text-light); line-height: 1; }
.limitation-title { font-weight: 700; font-size: var(--text-base); color: var(--text-navy); }
.limitation-desc { font-size: var(--text-sm); color: var(--text-secondary); line-height: 1.75; margin-bottom: var(--s4); }
.limitation-footer { display: flex; gap: var(--s3); flex-wrap: wrap; }

/* ══════════════════════════ DIFFERENTIATION ══════════════════════════ */
.diff-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: var(--s4); }

.diff-card {
  display: flex;
  align-items: flex-start;
  gap: var(--s4);
  background: var(--bg-white);
  border: 1px solid var(--border);
  border-radius: var(--r-xl);
  padding: var(--s5);
  transition: all var(--ease-base);
}

.diff-card:hover { box-shadow: var(--shadow-md); transform: translateY(-3px); border-color: var(--border-green); }

.diff-icon { font-size: 1.5rem; flex-shrink: 0; }
.diff-title { font-weight: 700; font-size: var(--text-sm); color: var(--text-navy); margin-bottom: 4px; }
.diff-desc { font-size: var(--text-xs); color: var(--text-secondary); line-height: 1.65; }

/* ══════════════════════════ EXPOSURE ══════════════════════════ */
.exposure-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: var(--s5); }

.exposure-scenario-card {
  background: var(--bg-white);
  border: 1px solid var(--border);
  border-radius: var(--r-xl);
  padding: var(--s6);
  transition: all var(--ease-base);
}

.exposure-scenario-card:hover { box-shadow: var(--shadow-lg); transform: translateY(-4px); }

