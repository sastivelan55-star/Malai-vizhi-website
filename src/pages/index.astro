</style>

<script>
  (() => {
    // ── GSAP ScrollTrigger Animations ──
    const initGSAP = () => {
      if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
        setTimeout(initGSAP, 200);
        return;
      }

      gsap.registerPlugin(ScrollTrigger);

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!reducedMotion) {
        // Generic reveal for .gsap-reveal-up elements
        gsap.utils.toArray('.gsap-reveal-up').forEach(el => {
          gsap.fromTo(el,
            { opacity: 0, y: 40 },
            {
              opacity: 1, y: 0, duration: 0.8, ease: 'power3.out',
              scrollTrigger: { trigger: el, start: 'top 85%', once: true }
            }
          );
        });

        // Right reveals
        gsap.utils.toArray('.gsap-reveal-right').forEach(el => {
          gsap.fromTo(el,
            { opacity: 0, x: 50 },
            {
              opacity: 1, x: 0, duration: 0.8, ease: 'power3.out',
              scrollTrigger: { trigger: el, start: 'top 85%', once: true }
            }
          );
        });

        // Scale reveals
        gsap.utils.toArray('.gsap-scale').forEach(el => {
          gsap.fromTo(el,
            { opacity: 0, scale: 0.94 },
            {
              opacity: 1, scale: 1, duration: 0.8, ease: 'power3.out',
              scrollTrigger: { trigger: el, start: 'top 85%', once: true }
            }
          );
        });

        // Hero entrance
        const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
        tl.from('.hero-label', { opacity: 0, y: 20, duration: 0.6, delay: 0.2 })
          .from('.hero-title-main', { opacity: 0, y: 40, duration: 0.8, stagger: 0.12 }, '-=0.3')
          .from('.hero-tagline', { opacity: 0, y: 20, duration: 0.6 }, '-=0.4')
          .from('.hero-desc', { opacity: 0, y: 20, duration: 0.6 }, '-=0.4')
          .from('.hero-actions', { opacity: 0, y: 16, duration: 0.5 }, '-=0.3')
          .from('.hero-status-strip', { opacity: 0, y: 10, duration: 0.5 }, '-=0.3')
          .from('.hero-panel', { opacity: 0, x: 40, duration: 0.8, ease: 'power2.out' }, '-=0.6');

        // Factor bars
        gsap.utils.toArray('.factor-bar-fill').forEach(bar => {
          ScrollTrigger.create({
            trigger: bar,
            start: 'top 90%',
            once: true,
            onEnter: () => bar.classList.add('animated'),
          });
        });

        // Number counter for hero stats
        document.querySelectorAll('.hero-stat-num').forEach(el => {
          const text = el.textContent;
          if (!isNaN(parseInt(text))) {
            const target = parseInt(text);
            gsap.from({ val: 0 }, {
              val: target, duration: 1.5, ease: 'power2.out',
              scrollTrigger: { trigger: el, start: 'top 90%', once: true },
              onUpdate: function() {
                el.textContent = Math.round(this.targets()[0].val).toString();
              }
            });
          }
        });
      } else {
        // No animation — just show elements
        document.querySelectorAll('.gsap-reveal-up, .gsap-reveal-right, .gsap-scale').forEach(el => {
          el.style.opacity = '1';
          el.style.transform = 'none';
        });
      }
    };

    initGSAP();

    // ── Hero Canvas — Rainfall ──
    const heroCanvas = document.getElementById('hero-canvas');
    if (heroCanvas) {
      const ctx = heroCanvas.getContext('2d');
      heroCanvas.width = heroCanvas.offsetWidth;
      heroCanvas.height = heroCanvas.offsetHeight;

      const particles = Array.from({ length: 60 }, () => ({
        x: Math.random() * heroCanvas.width,
        y: Math.random() * heroCanvas.height,
        speed: 1 + Math.random() * 2,
        length: 8 + Math.random() * 16,
        opacity: 0.1 + Math.random() * 0.25,
      }));

      const drawHero = () => {
        ctx.clearRect(0, 0, heroCanvas.width, heroCanvas.height);
        ctx.strokeStyle = 'rgba(45, 106, 79, 0.4)';
        ctx.lineWidth = 1;

        particles.forEach(p => {
          ctx.globalAlpha = p.opacity;
          ctx.beginPath();
          ctx.moveTo(p.x, p.y);
          ctx.lineTo(p.x - 2, p.y + p.length);
          ctx.stroke();

          p.y += p.speed;
          if (p.y > heroCanvas.height) {
            p.y = -p.length;
            p.x = Math.random() * heroCanvas.width;
          }
        });

        ctx.globalAlpha = 1;
        requestAnimationFrame(drawHero);
      };

      drawHero();

      window.addEventListener('resize', () => {
        heroCanvas.width = heroCanvas.offsetWidth;
        heroCanvas.height = heroCanvas.offsetHeight;
      });
    }

    // ── Rainfall Canvas (environment section) ──
    const rainCanvas = document.getElementById('rainfall-canvas');
    if (rainCanvas) {
      const rctx = rainCanvas.getContext('2d');
      const rParticles = Array.from({ length: 50 }, () => ({
        x: Math.random() * 300,
        y: Math.random() * 160,
        speed: 1.5 + Math.random() * 2.5,
        length: 6 + Math.random() * 12,
        opacity: 0.3 + Math.random() * 0.5,
      }));

      const drawRain = () => {
        rctx.clearRect(0, 0, 300, 160);
        rctx.strokeStyle = '#60A5FA';
        rctx.lineWidth = 1;

        rParticles.forEach(p => {
          rctx.globalAlpha = p.opacity;
          rctx.beginPath();
          rctx.moveTo(p.x, p.y);
          rctx.lineTo(p.x - 1, p.y + p.length);
          rctx.stroke();

          p.y += p.speed;
          if (p.y > 160) {
            p.y = -p.length;
            p.x = Math.random() * 300;
          }
        });

        rctx.globalAlpha = 1;
        requestAnimationFrame(drawRain);
      };

      drawRain();
    }

    // ── DEM Grid ──
    const demGrid = document.getElementById('dem-grid');
    if (demGrid) {
      const elevations = [
        820, 940, 1050, 1100, 1190, 1240, 1180, 1090,
        760, 870, 980, 1060, 1150, 1195, 1160, 1030,
        700, 800, 910, 1020, 1100, 1185, 1150, 1000,
        650, 750, 860, 970, 1060, 1130, 1110, 940,
        600, 700, 810, 920, 1010, 1080, 1050, 880,
        570, 660, 770, 870, 960, 1020, 980, 820,
        540, 630, 730, 830, 910, 960, 930, 770,
        520, 610, 710, 800, 870, 910, 880, 730,
      ];

      const minElev = Math.min(...elevations);
      const maxElev = Math.max(...elevations);

      elevations.forEach((elev, i) => {
        const cell = document.createElement('div');
        cell.className = 'dem-cell';
        const t = (elev - minElev) / (maxElev - minElev);
        const r = Math.round(29 + t * (59 - 29));
        const g = Math.round(78 + t * (130 - 78));
        const b = Math.round(216 + t * (184 - 216));
        cell.style.background = `rgb(${r},${g},${b})`;
        cell.title = `${elev}m`;

        // Highlight the max cell
        if (elev === 1240) {
          cell.style.outline = '2px solid #F87171';
          cell.style.outlineOffset = '1px';
          cell.style.zIndex = '1';
        }

        demGrid.appendChild(cell);
      });
    }

    // ── Risk Score API health check ──
    fetch('https://backend-malaivizhi2-0.onrender.com/api/health', { signal: AbortSignal.timeout(6000) })
      .then(r => r.json())
      .then(data => {
        if (data.status === 'ok') {
          const dot = document.getElementById('hero-system-dot');
          const text = document.getElementById('hero-system-status');
          if (dot) { dot.className = 'hero-status-dot green'; }
          if (text) text.textContent = 'SYSTEM LIVE';

          // Update panel badge
          const panelBadge = document.getElementById('hero-panel-badge');
          if (panelBadge) { panelBadge.innerHTML = '<span class="badge-dot"></span>API CONNECTED'; panelBadge.className = 'badge badge-live'; }
        }
      }).catch(() => {});

    // Fetch stats for hero panel
    Promise.all([
      fetch('https://backend-malaivizhi2-0.onrender.com/api/alerts', { signal: AbortSignal.timeout(10000) }).then(r=>r.json()).catch(()=>[]),
      fetch('https://backend-malaivizhi2-0.onrender.com/api/reports', { signal: AbortSignal.timeout(10000) }).then(r=>r.json()).catch(()=>[]),
    ]).then(([alerts, reports]) => {
      const statAlerts = document.getElementById('stat-alerts');
      const statReports = document.getElementById('stat-reports');
      if (statAlerts && Array.isArray(alerts)) statAlerts.textContent = alerts.length.toString();
      if (statReports && Array.isArray(reports)) statReports.textContent = reports.length.toString();
    });

    // ── Pipeline stage interaction ──
    const stages = document.querySelectorAll('.pipeline-stage');
    const details = document.querySelectorAll('.pipeline-detail');

    stages.forEach(stage => {
      const activate = () => {
        const id = stage.dataset.stage;
        stages.forEach(s => s.classList.remove('active'));
        details.forEach(d => d.classList.remove('visible'));
        stage.classList.add('active');
        document.getElementById(`pipeline-detail-${id}`)?.classList.add('visible');
      };

      stage.addEventListener('click', activate);
      stage.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); activate(); } });
    });

    // ── Interactive Risk Score Simulator ──
    const simRainfall = document.getElementById('sim-rainfall');
    const simSoil = document.getElementById('sim-soil');
    const simSlope = document.getElementById('sim-slope');
    const simScore = document.getElementById('sim-score');
    const simLevel = document.getElementById('sim-level');
    const simArcFill = document.getElementById('sim-arc-fill');
    const simConfBar = document.getElementById('sim-confidence-bar');
    const simConfVal = document.getElementById('sim-confidence-val');
    const factorBreakdown = document.getElementById('factor-breakdown');

    const calcRisk = () => {
      const rain = parseFloat(simRainfall?.value || 110);
      const soil = parseFloat(simSoil?.value || 80);
      const slope = parseFloat(simSlope?.value || 15);

      // Display values
      if (document.getElementById('sim-rainfall-val')) document.getElementById('sim-rainfall-val').textContent = `${Math.round(rain)} mm`;
      if (document.getElementById('sim-soil-val')) document.getElementById('sim-soil-val').textContent = `${Math.round(soil)} %`;
      if (document.getElementById('sim-slope-val')) document.getElementById('sim-slope-val').textContent = `${Math.round(slope)} °`;

      // PTS Calculation (illustrating backend landslide_model_v1)
      const rainPts = (Math.min(1, rain / 400)) * 40; // Max 40 pts
      const soilPts = (Math.min(1, soil / 100)) * 30; // Max 30 pts
      const slopePts = (Math.min(1, slope / 60)) * 20; // Max 20 pts
      const histPts = 5; // Base historical hazard
      
      const risk = Math.round(rainPts + soilPts + slopePts + histPts);
      const clampedRisk = Math.min(100, Math.max(0, risk));

      // Update slider backgrounds
      [simRainfall, simSoil, simSlope].forEach(slider => {
        if (slider) {
          const pct = ((slider.value - slider.min) / (slider.max - slider.min)) * 100;
          slider.style.setProperty('--pct', `${pct}%`);
        }
      });

      // Update score
      if (simScore) simScore.textContent = clampedRisk.toString();

      // Risk level
      let level = 'LOW';
      let levelColor = 'var(--risk-low)';
      let levelClass = 'badge-risk-low';
      if (clampedRisk >= 75) { level = 'HIGH'; levelColor = 'var(--risk-high)'; levelClass = 'badge-risk-high'; }
      else if (clampedRisk >= 45) { level = 'MODERATE'; levelColor = 'var(--risk-mod)'; levelClass = 'badge-risk-mod'; }

      if (simLevel) { 
        simLevel.textContent = level; 
        simLevel.className = `risk-level-badge ${levelClass}`;
        simLevel.style.color = levelColor;
        simLevel.style.borderColor = levelColor;
      }
      if (simScore) simScore.style.color = levelColor;

      // Arc fill (251 is full arc length)
      if (simArcFill) {
        const offset = 251 - (clampedRisk / 100) * 251;
        simArcFill.style.strokeDashoffset = offset.toString();
      }

      // Confidence (Exposure UNAVAILABLE = 90% confidence)
      const conf = 90;
      if (simConfBar) simConfBar.style.width = `${conf}%`;
      if (simConfVal) simConfVal.textContent = `${conf}%`;

      // Factor breakdown
      if (factorBreakdown) {
        factorBreakdown.innerHTML = [
          { name: 'Rainfall Contribution', score: rainPts.toFixed(1), max: 40 },
          { name: 'Soil Contribution', score: soilPts.toFixed(1), max: 30 },
          { name: 'Terrain Contribution', score: slopePts.toFixed(1), max: 20 },
        ].map(f => {
          const pct = (parseFloat(f.score) / f.max) * 100;
          return `
          <div class="pts-factor-row">
            <div class="pts-factor-header">
              <span class="pts-factor-name">${f.name}</span>
              <span class="pts-value">${f.score} pts</span>
            </div>
            <div class="pts-bar-track">
              <div class="pts-bar-fill" style="width: ${pct}%; background: ${pct >= 75 ? 'var(--risk-high)' : pct >= 45 ? 'var(--risk-mod)' : 'var(--risk-low)'};"></div>
            </div>
          </div>
        `}).join('');
      }
    };

    [simRainfall, simSoil, simSlope].forEach(slider => {
      slider?.addEventListener('input', calcRisk);
    });

    calcRisk();

    // ── What-If Simulation ──
    const baseRisk = 54;
    let rainMod = 0, soilMod = 0;

    const updateWhatIf = () => {
      const newRisk = Math.min(100, Math.round(baseRisk * (1 + rainMod * 0.4 + soilMod * 0.3)));
      const scoreEl = document.getElementById('whatif-new-score');
      const bar = document.getElementById('whatif-change-bar');
      const note = document.getElementById('whatif-change-note');
      const levelBadge = document.getElementById('whatif-level-badge');

      if (scoreEl) { scoreEl.textContent = newRisk.toString(); }

      let level = 'LOW';
      let color = 'var(--risk-low)';
      let badgeClass = 'badge badge-risk-low';
      if (newRisk >= 75) { level = 'HIGH'; color = 'var(--risk-high)'; badgeClass = 'badge badge-risk-high'; }
      else if (newRisk >= 45) { level = 'MODERATE'; color = 'var(--risk-mod)'; badgeClass = 'badge badge-risk-mod'; }

      if (scoreEl) scoreEl.style.color = color;
      if (bar) { bar.style.width = `${newRisk}%`; bar.style.background = color; }
      if (levelBadge) { levelBadge.textContent = level; levelBadge.className = badgeClass; }

      const diff = newRisk - baseRisk;
      if (note) {
        if (diff === 0) note.textContent = 'Scenario matches baseline.';
        else if (diff > 0) note.textContent = `Risk increases by +${diff} points under this scenario.`;
        else note.textContent = `Risk decreases by ${diff} points under this scenario.`;
      }
    };

    document.querySelectorAll('.whatif-btn[data-type="rain"]').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.whatif-btn[data-type="rain"]').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const val = btn.dataset.val;
        rainMod = val === '0' ? 0 : parseFloat(val) / 100;
        updateWhatIf();
      });
    });

    document.querySelectorAll('.whatif-btn[data-type="soil"]').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.whatif-btn[data-type="soil"]').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const val = btn.dataset.val;
        soilMod = val === '0' ? 0 : parseFloat(val) / 100;
        updateWhatIf();
      });
    });

    document.getElementById('whatif-reset')?.addEventListener('click', () => {
      rainMod = 0; soilMod = 0;
      document.querySelectorAll('.whatif-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.val === '0');
      });
      updateWhatIf();
    });

    updateWhatIf();

    // ── Sensor Failure Simulation ──
    const failureBtn = document.getElementById('failure-sim-btn');
    const failureSteps = document.querySelectorAll('[id^="failure-step-"]');

    failureBtn?.addEventListener('click', () => {
      // Reset
      failureSteps.forEach(step => { step.style.opacity = '0.25'; });
      failureBtn.disabled = true;
      failureBtn.textContent = 'Simulating…';

      // Animate sequentially
      failureSteps.forEach((step, i) => {
        setTimeout(() => {
          step.style.opacity = '1';
          step.style.transform = 'scale(1.02)';
          setTimeout(() => { step.style.transform = 'scale(1)'; }, 200);
          if (i === failureSteps.length - 1) {
            failureBtn.disabled = false;
            failureBtn.innerHTML = `<span>Reset & Replay</span>`;
          }
        }, i * 600);
      });
    });

  })();
</script>
</BaseLayout>
