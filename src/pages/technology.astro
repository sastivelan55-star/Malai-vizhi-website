---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Technology — MALAI VIZHI Stack & Architecture"
  description="The technology stack and architecture behind MALAI VIZHI: Astro.js, HTML, CSS, JavaScript, and GSAP animations."
>
  <Navigation slot="nav" />

  <!-- Hero -->
  <section class="page-hero" aria-labelledby="tech-hero-title">
    <div class="container">
      <div class="page-hero-inner">
        <div class="section-label reveal">
          <span class="label">Technology</span>
        </div>
        <h1 class="display-lg reveal" id="tech-hero-title">
          Built With<br/><span style="color: var(--color-green-primary);">Purpose</span>
        </h1>
        <p class="body-lg reveal" style="max-width:600px; margin-top: var(--space-6);">
          Every technology choice in MALAI VIZHI reflects the project's goals: fast content delivery, structured information, rich interaction, and accessibility.
        </p>
      </div>
    </div>
    <div class="page-hero-bg" aria-hidden="true">
      <svg viewBox="0 0 1200 300" fill="none" preserveAspectRatio="xMidYMax meet">
        <path d="M0 300 L0 180 Q200 140 400 160 Q600 180 800 150 Q1000 120 1200 140 L1200 300 Z" fill="#D8F3DC" opacity="0.5"/>
        <path d="M0 300 L0 240 Q300 215 600 225 Q900 235 1200 215 L1200 300 Z" fill="#B7E4C7" opacity="0.4"/>
      </svg>
    </div>
  </section>

  <hr class="section-divider" />

  <!-- Tech Stack -->
  <section class="section section-lg" aria-labelledby="stack-heading">
    <div class="container">
      <div style="text-align:center; margin-bottom: var(--space-16);">
        <div class="section-label reveal" style="justify-content:center;">
          <span class="label">The Stack</span>
        </div>
        <h2 class="display-md reveal" id="stack-heading">Technologies Used</h2>
        <p class="body-lg reveal" style="max-width:520px; margin: var(--space-6) auto 0;">
          A focused, purposeful set of technologies — no unnecessary complexity.
        </p>
      </div>

      <div class="tech-cards reveal">
        {[
          {
            name: 'Astro.js',
            category: 'Framework',
            version: 'v7',
            icon: `<svg width="40" height="40" viewBox="0 0 40 40" fill="none"><circle cx="20" cy="20" r="18" fill="#1B4332"/><path d="M20 8L28 28H12L20 8Z" fill="#74C69D"/><path d="M16 22l4-8 4 8" fill="none" stroke="#B7E4C7" stroke-width="1.5"/></svg>`,
            color: '#1B4332',
            desc: 'Astro provides a strong foundation for fast, content-focused websites. Its island architecture means JavaScript is only shipped where needed — keeping the website fast and performant.',
            uses: ['Static page generation', 'Component architecture', 'Content structure', 'Zero JS by default'],
          },
          {
            name: 'HTML5',
            category: 'Structure',
            version: 'Semantic',
            icon: `<svg width="40" height="40" viewBox="0 0 40 40" fill="none"><circle cx="20" cy="20" r="18" fill="#E2501A"/><text x="20" y="26" text-anchor="middle" font-family="monospace" font-weight="800" font-size="14" fill="white">H5</text></svg>`,
            color: '#E2501A',
            desc: 'Semantic HTML5 elements structure every page for accessibility, search engines, and maintainability. Headings, landmarks, and ARIA attributes are used throughout.',
            uses: ['Semantic structure', 'Accessibility landmarks', 'ARIA attributes', 'Form elements'],
          },
          {
            name: 'CSS',
            category: 'Styling',
            version: 'Vanilla CSS',
            icon: `<svg width="40" height="40" viewBox="0 0 40 40" fill="none"><circle cx="20" cy="20" r="18" fill="#0B73B7"/><text x="20" y="26" text-anchor="middle" font-family="monospace" font-weight="800" font-size="12" fill="white">CSS</text></svg>`,
            color: '#0B73B7',
            desc: 'Vanilla CSS with custom properties (CSS variables) provides the complete design system. No framework or preprocessor — every style is intentional and maintainable.',
            uses: ['CSS custom properties', 'Fluid typography', 'CSS Grid & Flexbox', 'CSS animations'],
          },
          {
            name: 'JavaScript',
            category: 'Interactivity',
            version: 'ES2022+',
            icon: `<svg width="40" height="40" viewBox="0 0 40 40" fill="none"><circle cx="20" cy="20" r="18" fill="#F7DF1E"/><text x="20" y="26" text-anchor="middle" font-family="monospace" font-weight="800" font-size="12" fill="#111">JS</text></svg>`,
            color: '#B8A900',
            desc: 'Modern JavaScript handles interactive features: navigation, terrain canvas animations, scroll detection, risk meter interaction, blog search, and more.',
            uses: ['Canvas animations', 'DOM interaction', 'Scroll detection', 'Dynamic UI states'],
          },
          {
            name: 'GSAP',
            category: 'Animation',
            version: 'v3.12',
            icon: `<svg width="40" height="40" viewBox="0 0 40 40" fill="none"><circle cx="20" cy="20" r="18" fill="#0AE448"/><text x="20" y="26" text-anchor="middle" font-family="monospace" font-weight="800" font-size="10" fill="#111">GSAP</text></svg>`,
            color: '#0AE448',
            desc: 'GreenSock Animation Platform drives all scroll-triggered animations, section reveals, the risk meter arc, number counters, and the system diagram line-draw animations.',
            uses: ['ScrollTrigger', 'Timeline animations', 'SVG animations', 'Number counters'],
          },
        ].map(tech => (
          <div class="tech-card" style={`--tc: ${tech.color}`}>
            <div class="tech-card-header">
              <div class="tech-icon" aria-hidden="true" set:html={tech.icon}></div>
              <div>
                <div class="tech-meta">
                  <span class="tech-category">{tech.category}</span>
                  <span class="tech-version">{tech.version}</span>
                </div>
                <h3 class="tech-name">{tech.name}</h3>
              </div>
            </div>
            <p class="tech-desc">{tech.desc}</p>
            <ul class="tech-uses" role="list">
              {tech.uses.map(u => (
                <li class="tech-use-item">
                  <span aria-hidden="true">→</span> {u}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <hr class="section-divider" />

  <!-- Why Astro -->
  <section class="section" style="background: var(--color-bg-soft);" aria-labelledby="why-astro-heading">
    <div class="container">
      <div class="tech-detail-inner">
        <div>
          <div class="section-label reveal">
            <span class="label">Architecture Decision</span>
          </div>
          <h2 class="display-md reveal" id="why-astro-heading">Why Astro?</h2>
          <div class="divider reveal"></div>
        </div>
        <div>
          <p class="body-lg reveal">
            Astro provides a strong foundation for fast, content-focused websites and structured content such as blog posts. Its component model allows the MALAI VIZHI website to be built from reusable, maintainable pieces.
          </p>
          <div class="astro-benefits reveal" style="margin-top: var(--space-8);">
            {[
              { title: 'Content-First', desc: 'Astro is designed for content-rich sites. Pages like the blog articles and the detailed "How It Works" sections benefit from Astro\'s structured component model.' },
              { title: 'Zero JS by Default', desc: 'Astro ships zero JavaScript to the browser by default. Interactive components only include JavaScript where explicitly needed — keeping the site fast.' },
              { title: 'Island Architecture', desc: 'Interactive islands (like the risk meter and canvas animations) are isolated from the static content, ensuring optimal performance.' },
              { title: 'Component Reuse', desc: 'Navigation, Footer, BlogCard, TeamCard and other components are written once and used across multiple pages without duplication.' },
            ].map(b => (
              <div class="astro-benefit-item">
                <p class="astro-benefit-title">{b.title}</p>
                <p class="astro-benefit-desc">{b.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <hr class="section-divider" />

  <!-- Animation Strategy -->
  <section class="section" aria-labelledby="animation-heading">
    <div class="container">
      <div style="text-align:center; margin-bottom: var(--space-16);">
        <div class="section-label reveal" style="justify-content:center;">
          <span class="label">Animation Strategy</span>
        </div>
        <h2 class="display-md reveal" id="animation-heading">Purposeful Motion</h2>
        <p class="body-lg reveal" style="max-width:560px; margin: var(--space-6) auto 0;">
          Every animation in MALAI VIZHI serves the storytelling. Animations are used to guide attention, reveal information progressively, and demonstrate concepts that are difficult to express with static visuals.
        </p>
      </div>
      <div class="anim-grid reveal">
        {[
          { type: 'Scroll-Triggered Reveals', desc: 'Content fades and slides into view as the user scrolls — guiding attention progressively through the story.' },
          { type: 'Risk Meter Arc', desc: 'The SVG arc animates from 0 to the target score, making the abstract concept of a risk score intuitive.' },
          { type: 'Rainfall Canvas', desc: 'HTML5 Canvas particles simulate rainfall on the hero section — reinforcing the environmental monitoring theme.' },
          { type: 'SVG Line Draw', desc: 'Architecture diagram lines draw themselves to reveal system connections sequentially.' },
          { type: 'Number Counters', desc: 'Numeric values count up from zero to their target, drawing attention to key data points.' },
          { type: 'Factor Bars', desc: 'Contribution bars fill to their percentage when scrolled into view — showing the weight of each risk factor visually.' },
          { type: 'Terrain Animation', desc: 'The problem section terrain gradually shows rainfall, soil saturation, and risk zones to demonstrate how conditions evolve.' },
          { type: 'Parallax Contours', desc: 'Mountain contour lines on the hero move at different speeds during scroll, creating natural depth.' },
        ].map(a => (
          <div class="anim-card">
            <p class="anim-type">{a.type}</p>
            <p class="anim-desc">{a.desc}</p>
          </div>
        ))}
      </div>
      <div class="highlight-box reveal" style="margin-top: var(--space-8); max-width: 600px; margin-left: auto; margin-right: auto;">
        <p style="font-size: var(--text-sm); color: var(--color-green-deep); line-height: 1.75; text-align: center;">
          All animations respect the <code style="font-family: var(--font-mono); font-size: var(--text-xs); background: rgba(45,106,79,0.1); padding: 1px 4px; border-radius: 3px;">prefers-reduced-motion</code> media query — users who prefer reduced motion will not see GSAP or CSS animations.
        </p>
      </div>
    </div>
  </section>

  <hr class="section-divider" />

  <!-- Architecture overview -->
  <section class="section" style="background: var(--color-bg-soft);" aria-labelledby="arch-heading">
    <div class="container">
      <div style="text-align:center; margin-bottom: var(--space-12);">
        <div class="section-label reveal" style="justify-content:center;">
          <span class="label">Project Architecture</span>
        </div>
        <h2 class="display-md reveal" id="arch-heading">File Structure</h2>
      </div>
      <div class="arch-tree-wrapper reveal">
        <div class="arch-tree">
          <pre class="arch-code"><code>{`symboic/
├── src/
│   ├── pages/
│   │   ├── index.astro          ← Home (scroll story)
│   │   ├── about.astro          ← About + Team
│   │   ├── how-it-works.astro   ← Pipeline deep-dive
│   │   ├── technology.astro     ← Tech stack
│   │   └── blog/
│   │       ├── index.astro      ← Blog listing
│   │       ├── understanding-malai-vizhi.astro
│   │       ├── how-malai-vizhi-works.astro
│   │       └── technology-behind-malai-vizhi.astro
│   ├── components/
│   │   ├── Navigation.astro     ← Sticky animated nav
│   │   ├── Footer.astro         ← 4-column footer
│   │   ├── Hero.astro           ← Terrain + canvas
│   │   ├── RiskMeter.astro      ← SVG arc gauge
│   │   ├── PipelineDiagram.astro← 5-stage pipeline
│   │   ├── SystemDiagram.astro  ← Architecture viz
│   │   ├── BlogCard.astro       ← Blog card
│   │   └── TeamCard.astro       ← Team member card
│   ├── layouts/
│   │   ├── BaseLayout.astro     ← HTML shell
│   │   └── BlogLayout.astro     ← Article layout
│   └── styles/
│       └── global.css           ← Design system
└── astro.config.mjs`}</code></pre>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .page-hero {
    padding: calc(var(--nav-height) + var(--space-20)) 0 var(--space-16);
    background: linear-gradient(170deg, #FFFFFF 0%, #F0F7F0 100%);
    position: relative; overflow: hidden;
  }
  .page-hero-bg { position: absolute; bottom: 0; left: 0; right: 0; pointer-events: none; }
  .page-hero-bg svg { width: 100%; height: auto; }
  .page-hero-inner { position: relative; z-index: 1; max-width: 800px; }

  .tech-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: var(--space-6);
  }

  @media (max-width: 768px) { .tech-cards { grid-template-columns: 1fr; } }

  .tech-card {
    background: white;
    border: 1.5px solid var(--color-border);
    border-top: 4px solid var(--tc, var(--color-green-primary));
    border-radius: var(--radius-xl);
    padding: var(--space-7);
    transition: all var(--transition-base);
  }

  .tech-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
    border-top-color: var(--tc);
    border-color: color-mix(in srgb, var(--tc, #2D6A4F) 30%, var(--color-border));
  }

  .tech-card-header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .tech-icon { flex-shrink: 0; }

  .tech-meta {
    display: flex;
    gap: var(--space-3);
    margin-bottom: var(--space-1);
    flex-wrap: wrap;
  }

  .tech-category {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--tc, var(--color-green-primary));
    background: color-mix(in srgb, var(--tc, #2D6A4F) 12%, transparent);
    padding: 2px 8px;
    border-radius: var(--radius-full);
  }

  .tech-version {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
    padding-top: 2px;
  }

  .tech-name {
    font-size: var(--text-xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  .tech-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.75;
    margin-bottom: var(--space-5);
  }

  .tech-uses {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .tech-use-item {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
  }

  .tech-use-item span {
    color: var(--tc, var(--color-green-primary));
    flex-shrink: 0;
  }

  /* Tech detail inner */
  .tech-detail-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: start;
  }

  @media (max-width: 860px) { .tech-detail-inner { grid-template-columns: 1fr; } }

  /* Astro benefits */
  .astro-benefits {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .astro-benefit-item {
    padding-left: var(--space-5);
    border-left: 3px solid var(--color-green-primary);
  }

  .astro-benefit-title {
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--color-text-primary);
    margin-bottom: var(--space-2);
  }

  .astro-benefit-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  /* Animation grid */
  .anim-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-5);
  }

  .anim-card {
    background: white;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5) var(--space-6);
    transition: all var(--transition-base);
  }

  .anim-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
    border-color: rgba(45,106,79,0.3);
  }

  .anim-type {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-green-primary);
    margin-bottom: var(--space-3);
    text-transform: uppercase;
  }

  .anim-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  /* Arch tree */
  .arch-tree-wrapper {
    display: flex;
    justify-content: center;
  }

  .arch-tree {
    background: var(--color-green-deep);
    border-radius: var(--radius-2xl);
    padding: var(--space-8) var(--space-10);
    overflow-x: auto;
    max-width: 680px;
    width: 100%;
  }

  .arch-code {
    margin: 0;
    white-space: pre;
  }

  .arch-code code {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.75;
    color: #74C69D;
  }

  @media (max-width: 640px) {
    .arch-tree { padding: var(--space-5) var(--space-5); }
    .arch-code code { font-size: var(--text-xs); }
  }
</style>

<script>
  (() => {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;
    gsap.registerPlugin(ScrollTrigger);
    document.querySelectorAll('.reveal').forEach(el => {
      gsap.from(el, {
        opacity: 0, y: 28, duration: 0.8, ease: 'power2.out',
        scrollTrigger: { trigger: el, start: 'top 88%', once: true }
      });
    });
    gsap.from('.tech-card', {
      opacity: 0, y: 24, duration: 0.6,
      stagger: 0.1, ease: 'power2.out',
      scrollTrigger: { trigger: '.tech-cards', start: 'top 75%', once: true }
    });
    gsap.from('.anim-card', {
      opacity: 0, y: 20, duration: 0.5,
      stagger: 0.07, ease: 'power2.out',
      scrollTrigger: { trigger: '.anim-grid', start: 'top 75%', once: true }
    });
  })();
</script>
