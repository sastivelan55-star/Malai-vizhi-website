    background: linear-gradient(165deg, #FAFAFA 0%, var(--green-bg) 100%);
    border-bottom: 1px solid var(--border);
  }

  .blog-article-meta {
    display: flex;
    align-items: center;
    gap: var(--s5);
    flex-wrap: wrap;
    margin-bottom: var(--s6);
  }

  .blog-back {
    display: flex;
    align-items: center;
    gap: var(--s2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: var(--green-primary);
    transition: gap var(--ease-base);
  }

  .blog-back:hover { gap: var(--s1); }

  .blog-article-category {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green-primary);
    background: var(--green-bg);
    padding: 4px 10px;
    border-radius: var(--r-full);
    border: 1px solid var(--border-green);
  }

  .blog-article-date, .blog-article-time {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .blog-article-title { margin: var(--s4) 0 var(--s6); }

  .blog-article-lead {
    font-size: var(--text-xl);
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: var(--s6);
    font-weight: 400;
  }

  .blog-article-author {
    display: flex;
    align-items: center;
    gap: var(--s4);
  }

  .blog-author-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--green-primary);
    color: white;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: var(--text-base);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .blog-author-name {
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--text-navy);
    display: block;
  }

  .blog-author-role {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    letter-spacing: 0.06em;
    display: block;
  }

  .blog-article-body-wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: var(--s12) var(--s8);
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: var(--s12);
    align-items: flex-start;
  }

  @media (max-width: 900px) {
    .blog-article-body-wrap { grid-template-columns: 1fr; }
    .blog-toc { display: none; }
  }

  .blog-toc {
    position: sticky;
    top: calc(var(--nav-h) + var(--s8));
  }

  .blog-toc-title {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--s4);
  }

  .blog-toc-list { display: flex; flex-direction: column; gap: 0; }

  .blog-article-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s5);
    margin-top: var(--s12);
    padding-top: var(--s8);
    border-top: 1px solid var(--border);
  }
