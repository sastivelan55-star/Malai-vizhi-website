    .blog-article-body-wrap { grid-template-columns: 1fr; }
    .blog-toc { display: none; }
  }

  .blog-toc {
    position: sticky;
    top: calc(var(--nav-h) + var(--s8));
  }

  .blog-toc-title {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--s4);
  }

  .blog-toc-list { display: flex; flex-direction: column; gap: 0; }

  .blog-article-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s5);
    margin-top: var(--s12);
    padding-top: var(--s8);
    border-top: 1px solid var(--border);
  }

  @media (max-width: 640px) { .blog-article-nav { grid-template-columns: 1fr; } }
</style>
