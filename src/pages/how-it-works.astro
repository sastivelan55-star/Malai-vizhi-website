---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import PipelineDiagram from '../components/PipelineDiagram.astro';
import RiskMeter from '../components/RiskMeter.astro';
---

<BaseLayout
  title="How MALAI VIZHI Works — Pipeline & Risk Analysis"
  description="Understand how MALAI VIZHI works: from data collection through processing, multi-factor risk analysis, risk score, early warning, and response."
>
  <Navigation slot="nav" />

  <!-- Hero -->
  <section class="page-hero" aria-labelledby="hiw-hero-title">
    <div class="container">
      <div class="page-hero-inner">
        <div class="section-label reveal">
          <span class="label">How It Works</span>
        </div>
        <h1 class="display-lg reveal" id="hiw-hero-title">
          From Data<br/>to <span style="color: var(--color-green-primary);">Decision</span>
        </h1>
        <p class="body-lg reveal" style="max-width:600px; margin-top: var(--space-6);">
          MALAI VIZHI transforms multiple environmental and terrain inputs into an understandable risk picture through a structured five-stage pipeline.
        </p>
      </div>
    </div>
    <div class="page-hero-bg" aria-hidden="true">
      <svg viewBox="0 0 1200 300" fill="none" preserveAspectRatio="xMidYMax meet">
        <path d="M0 300 L0 180 Q200 140 400 130 Q600 120 800 140 Q1000 160 1200 130 L1200 300 Z" fill="#D8F3DC" opacity="0.5"/>
        <path d="M0 300 L0 230 Q250 200 500 210 Q750 220 1000 200 Q1100 195 1200 200 L1200 300 Z" fill="#B7E4C7" opacity="0.4"/>
      </svg>
    </div>
  </section>

  <hr class="section-divider" />

  <!-- Pipeline overview -->
  <section class="section section-lg" id="pipeline" aria-labelledby="pipeline-heading">
    <div class="container">
      <div style="text-align:center; margin-bottom: var(--space-16);">
        <div class="section-label reveal" style="justify-content:center;">
          <span class="label">The Five-Stage Pipeline</span>
        </div>
        <h2 class="display-md reveal" id="pipeline-heading">The MALAI VIZHI Pipeline</h2>
        <p class="body-lg reveal" style="max-width:560px; margin: var(--space-6) auto 0;">
          Every piece of data travels through five stages before becoming an actionable risk assessment. Each stage is designed to transform raw inputs into structured, useful information.
        </p>
      </div>
      <PipelineDiagram />
    </div>
  </section>

  <hr class="section-divider" />

  <!-- Stage detail: COLLECT -->
  <section class="section stage-detail" style="background: var(--color-bg-soft);" id="collect" aria-labelledby="collect-heading">
    <div class="container">
      <div class="stage-detail-inner">
        <div class="stage-detail-label">
          <div class="stage-badge" style="--sc: #2D6A4F">
            <span class="stage-badge-num">01</span>
            <span class="stage-badge-text">COLLECT</span>
          </div>
        </div>
        <div class="stage-detail-content">
          <h2 class="display-md reveal" id="collect-heading">Data Collection</h2>
          <div class="divider reveal"></div>
          <p class="body-lg reveal">
            The first stage gathers environmental and terrain information from multiple sources. The diversity of input types is what makes MALAI VIZHI a multi-factor system.
          </p>
          <div class="data-source-grid reveal">
            {[
              { name: 'Rainfall', icon: '🌧', desc: 'Precipitation intensity and accumulation data. A primary driver of landslide risk through soil saturation.', color: '#3B82F6' },
              { name: 'Soil Moisture', icon: '💧', desc: 'Moisture content of the soil layer. High saturation reduces cohesion and increases slope instability.', color: '#06B6D4' },
              { name: 'Terrain & Slope', icon: '⛰', desc: 'Digital elevation model data used to derive slope angles. Steeper terrain amplifies other risk factors.', color: '#2D6A4F' },
              { name: 'Historical Hazard', icon: '📍', desc: 'Records of past landslide events in the area provide geographic hazard context for risk assessment.', color: '#7C3AED' },
              { name: 'GIS Information', icon: '🗺', desc: 'Spatial data about locations, roads, settlements and infrastructure provides geographic context.', color: '#0D9488' },
              { name: 'Ground Sensors', icon: '📡', desc: 'Field instruments can provide direct local measurements to supplement modeled data.', color: '#D97706' },
              { name: 'Citizen Reports', icon: '👥', desc: 'Ground-level observations submitted by community members provide contextual field information.', color: '#DB2777' },
            ].map(s => (
              <div class="data-source-card" style={`--dc: ${s.color}`}>
                <div class="ds-icon" aria-hidden="true">{s.icon}</div>
                <p class="ds-name">{s.name}</p>
                <p class="ds-desc">{s.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <hr class="section-divider" />

  <!-- Stage detail: PROCESS -->
  <section class="section stage-detail" id="process" aria-labelledby="process-heading">
    <div class="container">
      <div class="stage-detail-inner">
        <div class="stage-detail-label">
          <div class="stage-badge" style="--sc: #40916C">
            <span class="stage-badge-num">02</span>
            <span class="stage-badge-text">PROCESS</span>
          </div>
        </div>
        <div class="stage-detail-content">
          <h2 class="display-md reveal" id="process-heading">Data Processing</h2>
          <div class="divider reveal"></div>
          <p class="body-lg reveal">
            Raw data from multiple sources must be prepared before it can be used in analysis. The processing stage ensures that inputs are valid, comparable, and available.
          </p>
          <div class="process-steps reveal" style="margin-top: var(--space-8);">
            {[
              { step: 'Validation', desc: 'Data is checked for completeness, plausibility and format correctness. Invalid or implausible readings are flagged and excluded.' },
              { step: 'Normalization', desc: 'Different measurements (mm of rainfall, percentage soil moisture, degrees of slope) are converted into comparable factor scores on a common scale.' },
              { step: 'Availability Check', desc: 'The system records which data sources are available for a given assessment. Missing inputs are handled gracefully and noted in the confidence assessment.' },
              { step: 'Multi-Source Processing', desc: 'When data from multiple sensors or sources is available for the same factor, it is processed to produce a representative input value.' },
            ].map((p, i) => (
              <div class="process-step-item">
                <div class="ps-num">{String(i+1).padStart(2,'0')}</div>
                <div class="ps-content">
                  <p class="ps-name">{p.step}</p>
                  <p class="ps-desc">{p.desc}</p>
                </div>
              </div>
            ))}
          </div>
          <div class="highlight-box reveal" style="margin-top: var(--space-8);">
            <p style="font-size: var(--text-sm); color: var(--color-green-deep); line-height: 1.75;">
              <strong>Note on Normalization:</strong> Rainfall measured in millimetres, soil moisture as a percentage, and slope in degrees cannot be directly compared. Normalization converts each input into a 0–1 or 0–10 factor score that can then be combined meaningfully in the risk analysis.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <hr class="section-divider" />

  <!-- Stage detail: ASSESS -->
  <section class="section stage-detail" style="background: var(--color-bg-soft);" id="assess" aria-labelledby="assess-heading">
    <div class="container">
      <div class="stage-detail-inner">
        <div class="stage-detail-label">
          <div class="stage-badge" style="--sc: #1B4332">
            <span class="stage-badge-num">03</span>
            <span class="stage-badge-text">ASSESS</span>
          </div>
        </div>
        <div class="stage-detail-content">
          <h2 class="display-md reveal" id="assess-heading">Risk Assessment</h2>
          <div class="divider reveal"></div>
          <p class="body-lg reveal">
            The assessment stage is where MALAI VIZHI performs its multi-factor landslide risk analysis. Normalized factor scores are combined to produce a risk score and risk level.
          </p>

          <!-- Engine label -->
          <div class="engine-label reveal" style="margin-top: var(--space-8); margin-bottom: var(--space-8);">
            <div class="engine-box">
              <p class="engine-name">MULTI-FACTOR LANDSLIDE RISK ANALYSIS ENGINE</p>
              <p class="engine-desc">Empirical / physics-informed approach. Not a trained neural-network model.</p>
            </div>
          </div>

          <RiskMeter value={68} />
        </div>
      </div>
    </div>
  </section>

  <hr class="section-divider" />

  <!-- Stage detail: WARN -->
  <section class="section stage-detail" id="warn" aria-labelledby="warn-heading">
    <div class="container">
      <div class="stage-detail-inner">
        <div class="stage-detail-label">
          <div class="stage-badge" style="--sc: #D97706">
            <span class="stage-badge-num">04</span>
            <span class="stage-badge-text">WARN</span>
          </div>
        </div>
        <div class="stage-detail-content">
          <h2 class="display-md reveal" id="warn-heading">Early Warning</h2>
          <div class="divider reveal"></div>
          <p class="body-lg reveal">
            When risk assessment indicates elevated or high risk levels, MALAI VIZHI can communicate location-based early warnings. These are not guaranteed predictions — they are indicators of elevated hazard based on available data.
          </p>
          <div class="warn-levels reveal" style="margin-top: var(--space-8);">
            {[
              { level: 'NORMAL', range: 'Score 0–33', color: '#16A34A', bg: '#DCFCE7', desc: 'Environmental conditions do not indicate elevated hazard. Continuous background monitoring is active.' },
              { level: 'MODERATE RISK', range: 'Score 34–66', color: '#D97706', bg: '#FEF3C7', desc: 'Risk indicators are rising. Enhanced awareness is appropriate. Advisories may be issued.' },
              { level: 'HIGH RISK', range: 'Score 67–100', color: '#DC2626', bg: '#FEE2E2', desc: 'Risk indicators are in the high range. Alert notifications are sent to registered contacts and authorities.' },
            ].map(w => (
              <div class="warn-level-card" style={`--wc: ${w.color}; background: ${w.bg};`}>
                <div class="warn-level-header">
                  <span class="risk-badge" style={`background: ${w.bg}; color: ${w.color}; border: 1.5px solid ${w.color}40;`}>{w.level}</span>
                  <span class="warn-range" style={`color: ${w.color}`}>{w.range}</span>
                </div>
                <p class="warn-desc">{w.desc}</p>
              </div>
            ))}
          </div>
          <div class="highlight-box reveal" style="margin-top: var(--space-6);">
            <p style="font-size: var(--text-sm); color: var(--color-green-deep); line-height: 1.75;">
              <strong>Important:</strong> MALAI VIZHI provides early warning based on monitored conditions. It does not guarantee prediction of landslide occurrence. Actual landslide occurrence depends on many physical factors beyond those captured in the monitoring system.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <hr class="section-divider" />

  <!-- Stage detail: RESPOND -->
  <section class="section stage-detail" style="background: var(--color-bg-soft);" id="respond" aria-labelledby="respond-heading">
    <div class="container">
      <div class="stage-detail-inner">
        <div class="stage-detail-label">
          <div class="stage-badge" style="--sc: #DC2626">
            <span class="stage-badge-num">05</span>
            <span class="stage-badge-text">RESPOND</span>
          </div>
        </div>
        <div class="stage-detail-content">
          <h2 class="display-md reveal" id="respond-heading">Response</h2>
          <div class="divider reveal"></div>
          <p class="body-lg reveal">
            The value of risk monitoring is realized in the response stage — when communities and authorities take informed action based on the risk assessment. MALAI VIZHI supports response by making risk understandable, explainable, and location-specific.
          </p>
          <div class="respond-grid reveal" style="margin-top: var(--space-8);">
            <div class="respond-group">
              <p class="respond-group-title">Community Actions</p>
              <ul class="respond-list">
                {['Awareness of current risk level for local area','Understanding which factors are driving current risk','Submission of ground observations through citizen reporting','Ability to act on early warning advisories'].map(a => <li>{a}</li>)}
              </ul>
            </div>
            <div class="respond-group">
              <p class="respond-group-title">Authority Actions</p>
              <ul class="respond-list">
                {['Multi-location risk monitoring across a region','Tracking risk changes over time','Receiving high-risk alert notifications','Coordinating preparedness and response resources','Reviewing citizen reports for field verification'].map(a => <li>{a}</li>)}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section" style="border-top: 1px solid var(--color-border);" aria-label="Explore more">
    <div class="container-text" style="text-align:center;">
      <h2 class="display-md reveal" style="margin-bottom: var(--space-6);">Learn More</h2>
      <div class="hero-actions reveal" style="justify-content:center; gap: var(--space-4);">
        <a href="/blog/how-malai-vizhi-works" class="btn btn-primary">Read the Full Article</a>
        <a href="/technology" class="btn btn-outline">View Tech Stack</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .page-hero {
    padding: calc(var(--nav-height) + var(--space-20)) 0 var(--space-16);
    background: linear-gradient(170deg, #FFFFFF 0%, #F0F7F0 100%);
    position: relative;
    overflow: hidden;
  }
  .page-hero-bg { position: absolute; bottom: 0; left: 0; right: 0; pointer-events: none; }
  .page-hero-bg svg { width: 100%; height: auto; }
  .page-hero-inner { position: relative; z-index: 1; max-width: 800px; }

  .stage-detail-inner {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: var(--space-16);
    align-items: start;
  }

  @media (max-width: 860px) {
    .stage-detail-inner { grid-template-columns: 1fr; }
  }

  .stage-detail-label {
    position: sticky;
    top: calc(var(--nav-height-scrolled) + var(--space-6));
  }

  .stage-badge {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    background: var(--sc, #2D6A4F);
    color: white;
    border-radius: var(--radius-xl);
    padding: var(--space-4) var(--space-5);
    gap: var(--space-1);
    box-shadow: 0 4px 20px color-mix(in srgb, var(--sc, #2D6A4F) 40%, transparent);
  }

  .stage-badge-num {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    opacity: 0.8;
  }

  .stage-badge-text {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .stage-detail-content {
    max-width: 720px;
  }

  /* Data source grid */
  .data-source-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .data-source-card {
    background: white;
    border: 1.5px solid color-mix(in srgb, var(--dc, #2D6A4F) 25%, transparent);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    transition: all var(--transition-base);
  }

  .data-source-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--dc, #2D6A4F);
  }

  .ds-icon { font-size: 1.5rem; margin-bottom: var(--space-3); }

  .ds-name {
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--dc, #2D6A4F);
    margin-bottom: var(--space-2);
    letter-spacing: -0.01em;
  }

  .ds-desc {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  /* Process steps */
  .process-steps {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: white;
  }

  .process-step-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-5);
    padding: var(--space-6) var(--space-6);
    border-bottom: 1px solid var(--color-border);
    transition: background var(--transition-fast);
  }

  .process-step-item:last-child { border-bottom: none; }
  .process-step-item:hover { background: var(--color-bg-soft); }

  .ps-num {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-green-primary);
    min-width: 28px;
    padding-top: 2px;
  }

  .ps-name {
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--color-text-primary);
    margin-bottom: var(--space-2);
  }

  .ps-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  /* Engine box */
  .engine-box {
    border: 2px solid var(--color-green-primary);
    border-radius: var(--radius-xl);
    padding: var(--space-6) var(--space-8);
    background: var(--color-green-pale);
    text-align: center;
  }

  .engine-name {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-green-deep);
    margin-bottom: var(--space-2);
  }

  .engine-desc {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
  }

  /* Warn levels */
  .warn-levels {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .warn-level-card {
    border-left: 4px solid var(--wc, #2D6A4F);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    padding: var(--space-5) var(--space-6);
  }

  .warn-level-header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
  }

  .warn-range {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .warn-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  /* Respond grid */
  .respond-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
  }

  @media (max-width: 640px) { .respond-grid { grid-template-columns: 1fr; } }

  .respond-group {
    background: white;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6) var(--space-7);
  }

  .respond-group-title {
    font-weight: 700;
    font-size: var(--text-base);
    color: var(--color-text-primary);
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .respond-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .respond-list li {
    display: flex;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.65;
    align-items: flex-start;
  }

  .respond-list li::before {
    content: '→';
    color: var(--color-green-primary);
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 1px;
  }
</style>

<script>
  (() => {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;
    gsap.registerPlugin(ScrollTrigger);
    document.querySelectorAll('.reveal').forEach(el => {
      gsap.from(el, {
        opacity: 0, y: 28, duration: 0.8, ease: 'power2.out',
        scrollTrigger: { trigger: el, start: 'top 88%', once: true }
      });
    });
    gsap.from('.data-source-card', {
      opacity: 0, y: 20, scale: 0.95, duration: 0.5,
      stagger: 0.07, ease: 'back.out(1.5)',
      scrollTrigger: { trigger: '.data-source-grid', start: 'top 75%', once: true }
    });
  })();
</script>
